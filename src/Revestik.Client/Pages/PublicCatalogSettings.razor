@page "/settings/public-site/taxonomy"
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Administrator")]
<PageTitle>Catálogos de productos | Revestik</PageTitle>
<p role="status">Los catálogos se administran desde <a href="settings#settings-catalog-title">Configuración → Catálogos de productos</a>.</p>
@code {
    protected override void OnInitialized() => Navigation.NavigateTo("settings#settings-catalog-title", replace: true);
}

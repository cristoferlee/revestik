@page "/settings/public-site/taxonomy"
@using System.Net.Http
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Revestik.Client.Services.PublicCatalog
@attribute [Authorize(Roles = "Administrator")]
@inject PublicCatalogAdminApi Catalog

<PageTitle>Sitio web público | Revestik</PageTitle>
<section class="public-catalog-admin">
  <header class="public-catalog-admin__header">
    <a href="/settings/public-site">← Sitio web público</a>
    <h1>Sitio web público</h1>
    <p>Organizá las categorías y subcategorías públicas. Para crear o editar productos utilizá el editor visual.</p>
  </header>
  @if (!string.IsNullOrWhiteSpace(error)) { <p role="alert" class="public-catalog-admin__error">@error</p> }
  @if (!string.IsNullOrWhiteSpace(notice)) { <p role="status" class="public-catalog-admin__notice">@notice</p> }
  <nav class="public-catalog-admin__tabs" aria-label="Administración del sitio">
    <button type="button" class="@(tab=="categories"?"selected":"")" @onclick="ShowCategories">Categorías y portada</button>
    <button type="button" class="@(tab=="subcategories"?"selected":"")" @onclick="ShowSubcategories">Subcategorías</button>
    <a href="/settings/public-site/editor/acabados" class="public-catalog-admin__editor-link">Editar productos →</a>
  </nav>
  @if (busy) { <p role="status">Procesando…</p> }
  @if (tab=="categories")
  {
    <div class="public-catalog-admin__toolbar"><h2>Categorías públicas</h2><button type="button" @onclick="NewCategory">Nueva categoría</button></div>
    @foreach (var item in categories)
    {
      <article class="public-catalog-admin__item">
        <div><strong>@item.NameEs</strong><small>@item.Slug · @(item.IsActive?"Activa":"Inactiva")</small></div>
        <button type="button" @onclick="() => EditCategory(item)">Editar</button>
        <button type="button" @onclick="() => OpenCategoryImages(item)">Portada e imágenes</button>
      </article>
    }
    @if (categoryForm is not null)
    {
      <section class="public-catalog-admin__editor" aria-labelledby="category-editor-title">
        <h3 id="category-editor-title">@(categoryForm.Id==0?"Nueva categoría":"Editar categoría")</h3>
        <div class="public-catalog-admin__fields">
          <label>Identificador URL<input @bind="categoryForm.Slug" maxlength="160" /></label>
          <label>Nombre ES<input @bind="categoryForm.NameEs" maxlength="150" /></label>
          <label>Nombre EN<input @bind="categoryForm.NameEn" maxlength="150" /></label>
          <label>Nombre DE<input @bind="categoryForm.NameDe" maxlength="150" /></label>
          <label>Descripción ES<textarea @bind="categoryForm.DescriptionEs"></textarea></label>
          <label>Descripción EN<textarea @bind="categoryForm.DescriptionEn"></textarea></label>
          <label>Descripción DE<textarea @bind="categoryForm.DescriptionDe"></textarea></label>
          <label>Título de portada ES<input @bind="categoryForm.HeroTitleEs" /></label>
          <label>Título de portada EN<input @bind="categoryForm.HeroTitleEn" /></label>
          <label>Título de portada DE<input @bind="categoryForm.HeroTitleDe" /></label>
          <label>Descripción de portada ES<textarea @bind="categoryForm.HeroDescriptionEs"></textarea></label>
          <label>Descripción de portada EN<textarea @bind="categoryForm.HeroDescriptionEn"></textarea></label>
          <label>Descripción de portada DE<textarea @bind="categoryForm.HeroDescriptionDe"></textarea></label>
          <label>Orden<input type="number" min="0" @bind="categoryForm.DisplayOrder" /></label>
          <label class="public-catalog-admin__check"><input type="checkbox" @bind="categoryForm.IsActive" /> Activa</label>
        </div>
        <div class="public-catalog-admin__actions"><button type="button" disabled="@busy" @onclick="SaveCategory">Guardar categoría</button><button type="button" @onclick="() => categoryForm=null">Cancelar</button></div>
      </section>
    }
    @if (categoryImageOwner is not null)
    {
      <section class="public-catalog-admin__editor" aria-labelledby="category-image-title">
        <h3 id="category-image-title">Imágenes de @categoryImageOwner.NameEs</h3>
        <p>Subí primero un fallback estático antes de subir un portada animada. No hay carrusel automático.</p>
        <div class="public-catalog-admin__fields">
          <label>Uso de fotografía
            <select @bind="categoryImageRole">
              <option value="CategoryHeroFallback">Imagen estática alternativa</option>
              <option value="CategoryHeroPrimary">Imagen de portada (permite GIF)</option>
              <option value="CategoryGallery">Fotografía de ambiente</option>
            </select>
          </label>
          <label>Fallback para GIF
            <select @bind="categoryFallbackId">
              <option value="0">Seleccionar imagen estática</option>
              @foreach (var i in categoryImages.Where(x=>x.Role=="CategoryHeroFallback" && x.ContentType!="image/gif")) { <option value="@i.Id">Imagen @i.Id</option> }
            </select>
          </label>
          <label>Texto alternativo ES<input @bind="categoryAlt" maxlength="300" /></label>
          <label>Fotografía <InputFile OnChange="UploadCategoryImage" accept=".png,.jpg,.jpeg,.webp,.gif" disabled="@busy" /></label>
        </div>
        <div class="public-catalog-admin__image-grid">
          @foreach (var image in categoryImages.OrderBy(x=>x.DisplayOrder))
          {
            <article class="public-catalog-admin__image">
              <img src="@Catalog.ImageUri(image.Id)" alt="@(image.AltEs ?? image.Role)" loading="lazy" />
              <p>@image.Role · @image.ContentType</p>
              <label>Orden<input type="number" min="0" @bind="image.DisplayOrder" /></label>
              <label>Alt ES<input @bind="image.AltEs" /></label>
              <label>Alt EN<input @bind="image.AltEn" /></label>
              <label>Alt DE<input @bind="image.AltDe" /></label>
              <button type="button" disabled="@busy" @onclick="() => SaveImage(image)">Guardar imagen</button>
              <button type="button" disabled="@busy" @onclick="() => ConfirmImageDelete(image)">Eliminar</button>
            </article>
          }
        </div>
        <button type="button" @onclick="() => categoryImageOwner=null">Cerrar</button>
      </section>
    }
  }
  else if (tab=="subcategories")
  {
    <div class="public-catalog-admin__toolbar"><h2>Subcategorías</h2><button type="button" @onclick="NewSubcategory">Nueva subcategoría</button></div>
    @foreach (var item in subcategories)
    {
      <article class="public-catalog-admin__item"><div><strong>@item.NameEs</strong><small>@item.Slug · @(categories.FirstOrDefault(c=>c.Id==item.CategoryId)?.NameEs ?? "Categoría no encontrada")</small></div><button type="button" @onclick="() => EditSubcategory(item)">Editar</button></article>
    }
    @if (subcategoryForm is not null)
    {
      <section class="public-catalog-admin__editor"><h3>@(subcategoryForm.Id==0?"Nueva subcategoría":"Editar subcategoría")</h3>
        <div class="public-catalog-admin__fields">
          <label>Categoría<select @bind="subcategoryForm.CategoryId"><option value="0">Seleccionar</option>@foreach(var category in categories){<option value="@category.Id">@category.NameEs</option>}</select></label>
          <label>Slug<input @bind="subcategoryForm.Slug" /></label>
          <label>Nombre ES<input @bind="subcategoryForm.NameEs" /></label>
          <label>Nombre EN<input @bind="subcategoryForm.NameEn" /></label>
          <label>Nombre DE<input @bind="subcategoryForm.NameDe" /></label>
          <label>Descripción ES<textarea @bind="subcategoryForm.DescriptionEs"></textarea></label>
          <label>Descripción EN<textarea @bind="subcategoryForm.DescriptionEn"></textarea></label>
          <label>Descripción DE<textarea @bind="subcategoryForm.DescriptionDe"></textarea></label>
          <label>Orden<input type="number" min="0" @bind="subcategoryForm.DisplayOrder" /></label>
          <label class="public-catalog-admin__check"><input type="checkbox" @bind="subcategoryForm.IsActive" /> Activa</label>
        </div>
        <div class="public-catalog-admin__actions"><button type="button" disabled="@busy" @onclick="SaveSubcategory">Guardar</button><button type="button" @onclick="() => subcategoryForm=null">Cancelar</button></div>
      </section>
    }
  }
  @if (deleteImageCandidate is not null)
  {
    <div class="public-catalog-admin__modal-bg"><section class="public-catalog-admin__modal" role="dialog" aria-modal="true" aria-labelledby="delete-image-title">
      <h2 id="delete-image-title">Eliminar fotografía</h2><p>Esta acción no puede deshacerse. Las imágenes utilizadas por un portada animada y las portadas de productos publicados están protegidas.</p>
      <div class="public-catalog-admin__actions"><button type="button" disabled="@busy" @onclick="DeleteConfirmedImage">Eliminar</button><button type="button" @onclick="() => deleteImageCandidate=null">Cancelar</button></div>
    </section></div>
  }
</section>

@code {
  private bool busy;
  private string? error,notice;
  private string tab="categories";
  private List<AdminCategory> categories=[];
  private List<AdminSubcategory> subcategories=[];
  private AdminCategory? categoryForm,categoryImageOwner;
  private AdminSubcategory? subcategoryForm;
  private List<AdminImage> categoryImages=[];
  private AdminImage? deleteImageCandidate;
  private string categoryImageRole="CategoryHeroPrimary",categoryAlt="";
  private int categoryFallbackId;

  protected override async Task OnInitializedAsync()=>await Reload();
  private void ShowCategories()=>ChangeTab("categories");
  private void ShowSubcategories()=>ChangeTab("subcategories");
  private void ChangeTab(string value){tab=value;error=null;notice=null;categoryForm=null;subcategoryForm=null;categoryImageOwner=null;}
  private async Task Execute(Func<Task> operation,string message="Cambios guardados.")
  {
    if(busy)return;
    busy=true;error=null;notice=null;
    try { await operation();notice=message; }
    catch(Exception ex) when(ex is HttpRequestException or InvalidOperationException or TaskCanceledException){error=ex.Message;}
    finally {busy=false;}
  }
  private async Task Reload()
  {
    await Execute(async ()=>{categories=await Catalog.Categories();subcategories=await Catalog.Subcategories();},"Datos actualizados.");
  }
  private void NewCategory()=>categoryForm=new();
  private void EditCategory(AdminCategory item)=>categoryForm=new(){Id=item.Id,Slug=item.Slug,NameEs=item.NameEs,NameEn=item.NameEn,NameDe=item.NameDe,DescriptionEs=item.DescriptionEs,DescriptionEn=item.DescriptionEn,DescriptionDe=item.DescriptionDe,HeroTitleEs=item.HeroTitleEs,HeroTitleEn=item.HeroTitleEn,HeroTitleDe=item.HeroTitleDe,HeroDescriptionEs=item.HeroDescriptionEs,HeroDescriptionEn=item.HeroDescriptionEn,HeroDescriptionDe=item.HeroDescriptionDe,DisplayOrder=item.DisplayOrder,IsActive=item.IsActive,RowVersion=item.RowVersion};
  private async Task SaveCategory()=>await Execute(async ()=>{if(categoryForm is null)return;await Catalog.SaveCategory(categoryForm);categoryForm=null;categories=await Catalog.Categories();});
  private void NewSubcategory()=>subcategoryForm=new();
  private void EditSubcategory(AdminSubcategory item)=>subcategoryForm=new(){Id=item.Id,CategoryId=item.CategoryId,Slug=item.Slug,NameEs=item.NameEs,NameEn=item.NameEn,NameDe=item.NameDe,DescriptionEs=item.DescriptionEs,DescriptionEn=item.DescriptionEn,DescriptionDe=item.DescriptionDe,DisplayOrder=item.DisplayOrder,IsActive=item.IsActive,RowVersion=item.RowVersion};
  private async Task SaveSubcategory()=>await Execute(async ()=>{if(subcategoryForm is null)return;await Catalog.SaveSubcategory(subcategoryForm);subcategoryForm=null;subcategories=await Catalog.Subcategories();});
  private async Task OpenCategoryImages(AdminCategory category)=>await Execute(async ()=>{
    categoryImageOwner=category;categoryImages=await Catalog.Read<List<AdminImage>>($"api/admin/public-catalog/categories/{category.Id}/images");
  },"Fotografías cargadas.");
  private async Task UploadCategoryImage(InputFileChangeEventArgs args)=>await Execute(async ()=>{
    if(categoryImageOwner is null)return;
    var staged=await Catalog.Stage(args.File,categoryImageRole);
    try{
      await Catalog.AttachCategory(categoryImageOwner.Id,new(){Token=staged.Token,Role=categoryImageRole,ParentVersion=categoryImageOwner.VersionFromRow(),DisplayOrder=categoryImages.Count,AltEs=categoryAlt,FallbackImageId=categoryImageRole=="CategoryHeroPrimary"&&staged.ContentType=="image/gif"&&categoryFallbackId>0?categoryFallbackId:null});
      categories=await Catalog.Categories();categoryImageOwner=categories.Single(c=>c.Id==categoryImageOwner.Id);
      categoryImages=await Catalog.Read<List<AdminImage>>($"api/admin/public-catalog/categories/{categoryImageOwner.Id}/images");
    }catch{try{await Catalog.Discard(staged.Token);}catch{}throw;}
  },"Imagen de categoría agregada.");
  private async Task SaveImage(AdminImage image)=>await Execute(async ()=>{
    await Catalog.SaveImage(image);
    if(categoryImageOwner is not null){categoryImages=await Catalog.Read<List<AdminImage>>($"api/admin/public-catalog/categories/{categoryImageOwner.Id}/images");categories=await Catalog.Categories();categoryImageOwner=categories.Single(c=>c.Id==categoryImageOwner.Id);}
  });
  private void ConfirmImageDelete(AdminImage image)=>deleteImageCandidate=image;
  private async Task DeleteConfirmedImage()=>await Execute(async ()=>{
    if(deleteImageCandidate is null)return;
    await Catalog.DeleteImage(deleteImageCandidate);deleteImageCandidate=null;
    if(categoryImageOwner is not null){categoryImages=await Catalog.Read<List<AdminImage>>($"api/admin/public-catalog/categories/{categoryImageOwner.Id}/images");categories=await Catalog.Categories();categoryImageOwner=categories.Single(c=>c.Id==categoryImageOwner.Id);}
  },"Fotografía eliminada.");
}

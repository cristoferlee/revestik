@page "/projects/{ProjectId:int}"
@page "/projects/customer/{CustomerId:int}/new"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Revestik.Client.Services.Customers
@using Revestik.Client.Services.Locations
@using Revestik.Client.Services.Projects
@using Revestik.Client.Components.Projects
@using Revestik.Shared.Customers
@using Revestik.Shared.Locations
@using Revestik.Shared.Projects
@attribute [Authorize(Roles = "Administrator,Accountant,Sales")]
@inject ProjectApiService Api
@inject ICustomerApiService Customers
@inject ILocationApiService Locations
@inject AuthenticationStateProvider Auth
@inject NavigationManager Navigation
@inject HttpClient Http

<PageTitle>Expediente de proyecto | Revestik</PageTitle>
<section class="projects-page">
    <header class="projects-header">
        <div><a href="/projects" class="back-link">← Volver a proyectos</a><h1>@(isNew ? "Nuevo proyecto" : project?.Name ?? "Expediente")</h1><p>Cliente: @(customer?.Name ?? "Sin identificar")</p></div>
        @if (project is not null) { <span class="status-chip">@StatusLabel(project.Status)</span> }
    </header>
    @if (loading) { <p role="status">Cargando expediente...</p> }
    else if (error is not null && project is null && !isNew) { <p role="alert" class="status-message error-message">@error</p> }
    else
    {
        @if (error is not null) { <p role="alert" class="status-message error-message">@error</p> }
        @if (success is not null) { <p role="status" class="status-message">@success</p> }
        @if (project is not null)
        {
            <div class="projects-kpis">
                <article><span>Responsable</span><strong>@(isOwner ? "Mi proyecto" : "Responsable asignado")</strong></article>
                <article><span>Monto acordado</span><strong>@(project.AgreedAmount.HasValue ? $"{project.CurrencyCode} {project.AgreedAmount:N2}" : "Sin definir")</strong></article>
                <article><span>Saldo operativo</span><strong>@(balance?.RemainingBalance is decimal amount ? $"{balance.CurrencyCode} {amount:N2}" : "Sin definir")</strong></article>
            </div>
            <div class="projects-utility-actions"><a class="secondary-button" href="@(new Uri(Http.BaseAddress!, $"api/projects/{project.Id}/report.pdf"))" target="_blank" rel="noopener noreferrer">Descargar PDF</a></div>
            <nav class="projects-tabs" aria-label="Secciones del expediente">
                <button class="@(activeTab == "summary" ? "active-tab" : "future-tab")" @onclick='() => activeTab = "summary"'>Resumen</button><button class="@(activeTab == "activity" ? "active-tab" : "future-tab")" @onclick='() => activeTab = "activity"'>Actividad y tareas</button><button class="@(activeTab == "documents" ? "active-tab" : "future-tab")" @onclick='() => activeTab = "documents"'>Documentos</button><button class="@(activeTab == "payments" ? "active-tab" : "future-tab")" @onclick='() => activeTab = "payments"'>Abonos</button><button class="@(activeTab == "milestones" ? "active-tab" : "future-tab")" @onclick='() => activeTab = "milestones"'>Planes e hitos</button>
            </nav>
        }
        @if(project is not null && activeTab == "activity")
        {
            <ProjectActivityPanel ProjectId="@project.Id" CanWrite="@(canEdit && !IsClosed)" IsAdmin="@isAdmin" />
        }
        @if(project is not null && activeTab == "documents")
        {
            <ProjectDocumentsPanel ProjectId="@project.Id" CanWrite="@(canEdit && !IsClosed)" />
        }
        @if(project is not null && activeTab == "payments")
        {
            <ProjectPaymentsPanel ProjectId="@project.Id" CanWrite="@(canEdit && !IsClosed)" />
        }
        @if(project is not null && activeTab == "milestones")
        {
            <ProjectMilestonesPanel ProjectId="@project.Id" CanWrite="@(canEdit && !IsClosed)" IsAdmin="@isAdmin" />
        }
        @if(isNew || activeTab == "summary")
        {
        <section class="projects-card" aria-labelledby="general-title">
            <div class="section-title projects-between">
                <div><h2 id="general-title">@(isNew ? "Registrar expediente" : "Información general")</h2><p>@(isNew || showGeneralEditor ? "Los campos obligatorios y condicionales están identificados." : "Información principal y contactos del expediente.")</p></div>
                @if (!isNew && canEdit && !IsClosed && !showGeneralEditor) { <button type="button" class="secondary-button" @onclick="StartGeneralEdit">Editar datos</button> }
            </div>
            @if (!isNew && !showGeneralEditor && project is not null)
            {
                <div class="project-read-grid">
                    <div class="project-read-item project-read-wide"><span>Nombre</span><strong>@project.Name</strong></div>
                    <div class="project-read-item"><span>Inicio estimado</span><strong>@(project.EstimatedStartDate?.ToString("dd/MM/yyyy") ?? "Sin definir")</strong></div>
                    <div class="project-read-item"><span>Fin estimado</span><strong>@(project.EstimatedEndDate?.ToString("dd/MM/yyyy") ?? "Sin definir")</strong></div>
                    <div class="project-read-item project-read-wide"><span>Descripción</span><p>@(string.IsNullOrWhiteSpace(project.Description) ? "Sin descripción" : project.Description)</p></div>
                    <div class="project-read-item project-read-wide"><span>Ubicación</span><p>@(string.IsNullOrWhiteSpace(project.OtherSigns) ? "Sin señas registradas" : project.OtherSigns)</p>@if (project.ProvinceCode is not null) { <small>Provincia: @project.ProvinceCode · Cantón: @project.CantonCode · Distrito: @project.DistrictCode</small> }</div>
                </div>
                <div class="project-read-contacts"><h3>Contactos del proyecto</h3>
                    @if (project.Contacts.Count == 0) { <p class="empty">No hay contactos adicionales.</p> }
                    else { <div class="project-contact-list">@foreach (var contact in project.Contacts) { <article><strong>@contact.Name</strong><span>@contact.Role</span>@if(!string.IsNullOrWhiteSpace(contact.PhoneNumber)) { <span>@contact.PhoneNumber</span> }@if(!string.IsNullOrWhiteSpace(contact.Email)) { <span>@contact.Email</span> }</article> }</div> }
                </div>
            }
            @if (isNew || showGeneralEditor)
            {
            @if (validationErrors.Count > 0)
            {
                <div class="project-validation-summary" role="alert" aria-labelledby="project-validation-title">
                    <strong id="project-validation-title">Revise los datos antes de guardar:</strong>
                    <ul>@foreach (var message in validationErrors) { <li>@message</li> }</ul>
                </div>
            }
            <form @onsubmit="SaveAsync" @onsubmit:preventDefault>
                <fieldset disabled="@(saving || !canEdit)" class="projects-fieldset">
                    <div class="projects-fields">
                        <div class="field"><label for="name">Nombre del proyecto <span class="required-marker">(obligatorio)</span></label><input id="name" required maxlength="150" aria-required="true" aria-describedby="name-help" @bind="form.Name" /><small id="name-help" class="project-field-help">Ejemplo: Remodelación de cocina — máximo 150 caracteres. El nombre no debe repetirse para este cliente.</small></div>
                        <div class="field"><label for="start">Inicio estimado (opcional)</label><input id="start" type="date" aria-describedby="start-help" @bind="form.Start" /><small id="start-help" class="project-field-help">Ejemplo: 20/10/2026. Si indica fechas, el fin no puede ser anterior al inicio.</small></div>
                        <div class="field"><label for="end">Fin estimado (opcional)</label><input id="end" type="date" aria-describedby="end-help" @bind="form.End" /><small id="end-help" class="project-field-help">Ejemplo: 30/11/2026. Puede dejarlo vacío mientras no tenga una fecha estimada.</small></div>
                        <div class="field span-all"><label for="description">Descripción (opcional)</label><textarea id="description" maxlength="2000" rows="3" aria-describedby="description-help" @bind="form.Description"></textarea><small id="description-help" class="project-field-help">Ejemplo: Instalación de cerámica y renovación de muebles; máximo 2.000 caracteres.</small></div>
                        <div class="field"><label for="province">Provincia (opcional, en conjunto)</label><select id="province" aria-describedby="location-help" value="@form.Province" @onchange="ProvinceChangedAsync"><option value="">Sin seleccionar</option>@foreach (var p in provinces) { <option value="@p.Code">@p.Name</option> }</select><small id="location-help" class="project-field-help">Si registra ubicación, seleccione también cantón y distrito. Puede dejar los tres sin seleccionar.</small></div>
                        <div class="field"><label for="canton">Cantón (condicional)</label><select id="canton" aria-describedby="canton-help" value="@form.Canton" @onchange="CantonChangedAsync" disabled="@(form.Province is null)"><option value="">Sin seleccionar</option>@foreach (var c in cantons) { <option value="@c.Code">@c.Name</option> }</select><small id="canton-help" class="project-field-help">Obligatorio cuando se selecciona provincia. Ejemplo: cantón correspondiente a la provincia elegida.</small></div>
                        <div class="field"><label for="district">Distrito (condicional)</label><select id="district" aria-describedby="district-help" @bind="form.District" disabled="@(form.Canton is null)"><option value="">Sin seleccionar</option>@foreach (var d in districts) { <option value="@d.Code">@d.Name</option> }</select><small id="district-help" class="project-field-help">Obligatorio cuando indica provincia y cantón.</small></div>
                        <div class="field span-all"><label for="signs">Otras señas (opcional)</label><input id="signs" maxlength="160" aria-describedby="signs-help" @bind="form.OtherSigns" /><small id="signs-help" class="project-field-help">Ejemplo: 200 m al norte de la iglesia, casa blanca; máximo 160 caracteres.</small></div>
                    </div>
                    <h3>Contactos del proyecto (opcional)</h3>
                    <p class="project-field-help" id="contacts-help">Solo agregue un contacto si lo necesita. Por cada contacto agregado, nombre y rol son obligatorios; teléfono y correo son opcionales. Ejemplo: Miguel Rodríguez — Propietario — 8888-8888 — miguel@ejemplo.com.</p>
                    @foreach (var item in form.Contacts)
                    {
                        <div class="project-contact-group" @key="item" role="group" aria-label="Contacto del proyecto">
                            <div class="contact-row">
                                <label>Nombre (obligatorio)<input required maxlength="150" aria-required="true" aria-describedby="contacts-help" placeholder="Ej.: Miguel Rodríguez" @bind="item.Name" /></label>
                                <label>Rol (obligatorio)<input required maxlength="100" aria-required="true" aria-describedby="contacts-help" placeholder="Ej.: Propietario" @bind="item.Role" /></label>
                                <label>Teléfono (opcional)<input type="tel" maxlength="20" placeholder="Ej.: 8888-8888" @bind="item.Phone" /></label>
                                <label>Correo (opcional)<input type="email" maxlength="254" placeholder="Ej.: miguel@ejemplo.com" @bind="item.Email" /></label>
                                <button type="button" class="secondary-button" aria-label="Quitar contacto de esta fila" @onclick="() => form.Contacts.Remove(item)">Quitar</button>
                            </div>
                        </div>
                    }
                    @if (canEdit && form.Contacts.Count < 30) { <button type="button" class="secondary-button" @onclick="() => form.Contacts.Add(new())">Agregar contacto</button> }
                    @if (isNew)
                    {
                        <h3>Monto inicial opcional</h3>
                        <div class="projects-fields"><div class="field"><label for="initial-amount">Monto acordado (opcional, en conjunto)</label><input id="initial-amount" type="number" min="0" step="0.01" aria-describedby="initial-amount-help" @bind="form.AgreedAmount" /><small id="initial-amount-help" class="project-field-help">Ejemplo: 125000.00. Si registra un monto, seleccione una moneda; si no, deje ambos vacíos.</small></div><div class="field"><label for="initial-currency">Moneda (condicional)</label><select id="initial-currency" aria-describedby="initial-currency-help" @bind="form.Currency"><option value="">Sin monto</option><option value="CRC">CRC</option><option value="USD">USD</option></select><small id="initial-currency-help" class="project-field-help">Obligatoria si registra un monto. Seleccione CRC (colones) o USD (dólares).</small></div></div>
                    }
                </fieldset>
                @if (canEdit) { <div class="actions">@if (!isNew) { <button type="button" class="secondary-button" disabled="@saving" @onclick="CancelGeneralEdit">Cancelar</button> }<button class="primary-button" type="submit" disabled="@saving">@(saving ? "Guardando..." : isNew ? "Crear proyecto" : "Guardar cambios")</button></div> }
            </form>
            }
        </section>
        @if (project is not null && canEdit)
        {
            <section class="projects-card">
                <div class="section-title projects-between"><div><h2>Monto acordado</h2><p>Los cambios requieren motivo y se conservan en el historial.</p></div>@if (!showAmountEditor && !IsClosed) { <button type="button" class="secondary-button" @onclick="() => showAmountEditor = true">Modificar monto</button> }</div>
                <div class="project-inline-summary"><strong>@(project.AgreedAmount.HasValue ? $"{project.CurrencyCode} {project.AgreedAmount:N2}" : "Sin definir")</strong><span>Saldo pendiente: @(balance?.RemainingBalance is decimal pending ? $"{balance.CurrencyCode} {pending:N2}" : "Sin definir")</span></div>
                @if (showAmountEditor && !IsClosed)
                {
                    <div class="projects-fields"><div class="field"><label for="agreed-amount">Nuevo importe</label><input id="agreed-amount" type="number" min="0" step="0.01" @bind="newAmount" /></div><div class="field"><label for="agreed-currency">Moneda</label><select id="agreed-currency" @bind="newCurrency"><option value="">Sin monto</option><option value="CRC">CRC</option><option value="USD">USD</option></select></div><div class="field span-all"><label for="amount-reason">Motivo del cambio (obligatorio)</label><textarea id="amount-reason" rows="2" maxlength="500" aria-describedby="amount-reason-help" @bind="amountReason"></textarea><small id="amount-reason-help" class="project-field-help">Explique por qué se modifica el monto acordado.</small></div></div>
                    <div class="actions"><button type="button" class="secondary-button" @onclick="CancelAmountEdit">Cancelar</button><button type="button" class="primary-button" disabled="@(saving || string.IsNullOrWhiteSpace(amountReason))" @onclick="ChangeAmountAsync">Guardar monto</button></div>
                }
            </section>
            <section class="projects-card" aria-labelledby="lifecycle-title">
                <div class="section-title">
                    <h2 id="lifecycle-title">Estado del proyecto</h2>
                    <p>El estado indica en qué etapa está el trabajo. Las visitas, acuerdos y cambios diarios se registran en Actividad.</p>
                </div>
                <div class="lifecycle-summary">
                    <div><span class="lifecycle-label">Estado actual</span><strong>@StatusLabel(project.Status)</strong></div>
                    <p>Los cambios de estado quedan registrados automáticamente con la fecha, hora y usuario que los realizó.</p>
                </div>
                @if (!showLifecycleEditor)
                {
                    <div class="actions"><button type="button" class="secondary-button" @onclick="OpenLifecycleEditor">Gestionar estado</button></div>
                }
                else
                {
                    <div class="lifecycle-editor">
                        @if (project.Status == ProjectStatus.Completed)
                        {
                            <h3>Reabrir proyecto</h3>
                            <p class="lifecycle-help">Use esta operación si el proyecto ya finalizado necesita continuar. Debe indicar el motivo.</p>
                            <div class="projects-fields">
                                <div class="field"><label for="reopen-target">Volver al estado (obligatorio)</label>
                                    <select id="reopen-target" @bind="target"><option value="@ProjectStatus.Planning">Planificación</option><option value="@ProjectStatus.Active">Activo</option></select>
                                    <small id="reopen-target-help" class="lifecycle-help">Por ejemplo: Activo, si se reanudaron los trabajos.</small></div>
                                <div class="field span-all"><label for="reopen-reason">Motivo de reapertura (obligatorio)</label>
                                    <textarea id="reopen-reason" maxlength="500" required aria-describedby="reopen-reason-help" @bind="reason"></textarea>
                                    <small id="reopen-reason-help" class="lifecycle-help">Ejemplo: El cliente solicitó trabajos adicionales. Máximo 500 caracteres.</small></div>
                            </div>
                            <div class="actions"><button type="button" class="secondary-button" @onclick="CancelLifecycleEditor">Cancelar</button><button type="button" class="primary-button" disabled="@(saving || string.IsNullOrWhiteSpace(reason))" @onclick="ReopenAsync">Guardar reapertura</button></div>
                        }
                        else
                        {
                            <h3>Cambiar etapa</h3>
                            <div class="projects-fields">
                                <div class="field"><label for="lifecycle-target">Nuevo estado (obligatorio)</label>
                                    <select id="lifecycle-target" @bind="target" aria-describedby="lifecycle-target-help">
                                        @foreach (var state in Enum.GetValues<ProjectStatus>().Where(x => x != ProjectStatus.Completed && x != project.Status))
                                        {
                                            <option value="@state">@StatusLabel(state)</option>
                                        }
                                    </select>
                                    <small id="lifecycle-target-help" class="lifecycle-help">Ejemplo: Pendiente de aprobación, cuando la propuesta está esperando autorización.</small></div>
                                <div class="field"><label>Fecha del registro (automática)</label>
                                    <p class="lifecycle-date" role="status">@DateTime.Today.ToString("dd/MM/yyyy")</p>
                                    <small class="lifecycle-help">El sistema guarda la fecha y hora reales al confirmar el cambio. No es una fecha retroactiva editable.</small></div>
                                @if (target is ProjectStatus.Cancelled or ProjectStatus.Archived)
                                {
                                    <div class="field span-all"><label for="lifecycle-reason">Motivo (obligatorio)</label>
                                        <textarea id="lifecycle-reason" maxlength="500" required aria-describedby="lifecycle-reason-help" @bind="reason"></textarea>
                                        <small id="lifecycle-reason-help" class="lifecycle-help">Explique por qué se cancela o archiva. Ejemplo: El cliente solicitó detener el proyecto. Máximo 500 caracteres.</small></div>
                                }
                            </div>
                            <div class="actions"><button type="button" class="secondary-button" @onclick="CancelLifecycleEditor">Cancelar</button><button type="button" class="primary-button" disabled="@(saving || project.Status == target || ((target is ProjectStatus.Cancelled or ProjectStatus.Archived) && string.IsNullOrWhiteSpace(reason)))" @onclick="TransitionAsync">Guardar estado</button></div>
                            @if (project.Status is not (ProjectStatus.Cancelled or ProjectStatus.Archived))
                            {
                                <div class="lifecycle-finalize">
                                    @if (!showCloseEditor)
                                    {
                                        <h3>¿Terminó el proyecto?</h3>
                                        <p class="lifecycle-help">Finalizar es distinto de cambiar de etapa. Dejará el proyecto completado y restringirá sus modificaciones.</p>
                                        <button type="button" class="secondary-button" @onclick="() => showCloseEditor = true">Finalizar proyecto</button>
                                    }
                                    else
                                    {
                                        <h3>Finalizar proyecto</h3>
                                        <div class="projects-fields">
                                            <div class="field"><label for="closing-date">Fecha real de finalización (obligatoria)</label>
                                                <input id="closing-date" type="date" required @bind="closedOn" aria-describedby="closing-date-help" />
                                                <small id="closing-date-help" class="lifecycle-help">Día en que terminó realmente el trabajo; puede ser distinto de la fecha estimada.</small></div>
                                            <div class="field span-all"><label for="closing-notes">Observaciones del cierre (opcional)</label>
                                                <textarea id="closing-notes" maxlength="2000" @bind="closingNotes" aria-describedby="closing-notes-help"></textarea>
                                                <small id="closing-notes-help" class="lifecycle-help">Ejemplo: Obra entregada al cliente y pendiente de revisión final. Máximo 2000 caracteres.</small></div>
                                        </div>
                                        <p class="lifecycle-help">No se exige documento de respaldo para finalizar. Las evidencias pueden conservarse en la pestaña Documentos.</p>
                                        <div class="actions"><button type="button" class="secondary-button" @onclick="() => showCloseEditor = false">Cancelar cierre</button><button type="button" class="primary-button" disabled="@saving" @onclick="CloseAsync">Confirmar finalización</button></div>
                                    }
                                </div>
                            }
                        }
                    </div>
                }
            </section>
            @if (isAdmin)
            {
                <section class="projects-card"><div class="section-title projects-between"><div><h2>Responsable del proyecto</h2><p>Gestión administrativa, disponible solo para Administrator.</p></div>@if (!showReassignmentEditor) { <button type="button" class="secondary-button" @onclick="() => showReassignmentEditor = true">Reasignar</button> }</div>
                    <p class="project-inline-summary">@(isOwner ? "Proyecto a mi cargo" : "Responsable actualmente asignado")</p>
                    @if (showReassignmentEditor) { <div class="field"><label for="responsible-id">Identificador del usuario de destino</label><input id="responsible-id" aria-describedby="responsible-help" @bind="newResponsible" /><small id="responsible-help" class="project-field-help">Esta operación administrativa utiliza el identificador existente. La selección por nombre requiere una consulta de usuarios autorizados que aún debe verificarse.</small></div><div class="actions"><button type="button" class="secondary-button" @onclick="() => showReassignmentEditor = false">Cancelar</button><button type="button" class="primary-button" disabled="@(saving || string.IsNullOrWhiteSpace(newResponsible))" @onclick="ReassignAsync">Confirmar reasignación</button></div> }
                </section>
            }
        }
        }
    }
</section>
@code {
    [Parameter] public int ProjectId { get; set; }
    [Parameter] public int CustomerId { get; set; }
    private bool isNew => CustomerId > 0;
    private bool loading = true, saving, isAdmin, isOwner;
    private string activeTab = "summary";
    private bool showLifecycleEditor, showCloseEditor, showGeneralEditor, showAmountEditor, showReassignmentEditor;
    private bool IsClosed => project?.Status is ProjectStatus.Completed or ProjectStatus.Cancelled or ProjectStatus.Archived;
    private bool canEdit => isNew || isAdmin || isOwner;
    private string? error, success, userId;
    private ProjectResponse? project;
    private CustomerResponse? customer;
    private ProjectBalanceResponse? balance;
    private ProjectForm form = new();
    private readonly List<string> validationErrors = [];
    private IReadOnlyList<LocationOptionResponse> provinces = [], cantons = [], districts = [];
    private ProjectStatus target = ProjectStatus.Active;
    private string reason = "", closingNotes = "", amountReason = "", newResponsible = "";
    private DateOnly closedOn = DateOnly.FromDateTime(DateTime.Today);
    private void OpenLifecycleEditor()
    {
        if (project is null) return;
        target = project.Status == ProjectStatus.Completed ? ProjectStatus.Planning :
            Enum.GetValues<ProjectStatus>().First(x => x != ProjectStatus.Completed && x != project.Status);
        reason = "";
        showCloseEditor = false;
        showLifecycleEditor = true;
    }
    private void CancelLifecycleEditor()
    {
        showLifecycleEditor = false;
        showCloseEditor = false;
        reason = "";
    }
    private void StartGeneralEdit() { if (project is null) return; form = ProjectForm.From(project); validationErrors.Clear(); showGeneralEditor = true; }
    private void CancelGeneralEdit() { if (project is not null) form = ProjectForm.From(project); validationErrors.Clear(); showGeneralEditor = false; }
    private void CancelAmountEdit() { if (project is not null) { newAmount = project.AgreedAmount; newCurrency = project.CurrencyCode; } amountReason = ""; showAmountEditor = false; }
    private decimal? newAmount;
    private string? newCurrency;

    protected override async Task OnParametersSetAsync()
    {
        loading = true; error = success = null;
        try
        {
            var auth = (await Auth.GetAuthenticationStateAsync()).User;
            userId = auth.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            isAdmin = auth.IsInRole("Administrator");
            provinces = await Locations.GetProvincesAsync();
            project = isNew ? null : await Api.GetAsync(ProjectId);
            if (!isNew && project is null) { error = "Proyecto no encontrado."; return; }
            customer = await Customers.GetByIdAsync(isNew ? CustomerId : project!.CustomerId);
            if (customer is null) { error = "Cliente no encontrado."; return; }
            isOwner = project is not null && project.ResponsibleUserId == userId;
            if (isNew && !customer.IsActive) { error = "No se pueden crear proyectos para clientes inactivos."; return; }
            form = project is null ? new() : ProjectForm.From(project);
            showGeneralEditor = isNew; showAmountEditor = false; showReassignmentEditor = false;
            if (form.Province is not null) cantons = await Locations.GetCantonsAsync(form.Province);
            if (form.Province is not null && form.Canton is not null) districts = await Locations.GetDistrictsAsync(form.Province, form.Canton);
            if (project is not null) { balance = await Api.BalanceAsync(project.Id); newAmount = project.AgreedAmount; newCurrency = project.CurrencyCode; target = project.Status == ProjectStatus.Completed ? ProjectStatus.Planning : project.Status; }
        }
        catch (Exception ex) { error = "No fue posible cargar el expediente. " + ex.Message; }
        finally { loading = false; }
    }
    private async Task ProvinceChangedAsync(ChangeEventArgs args)
    {
        form.Province = args.Value?.ToString() is { Length: > 0 } s ? s : null;
        form.Canton = form.District = null; cantons = districts = [];
        if (form.Province is not null) try { cantons = await Locations.GetCantonsAsync(form.Province); } catch (Exception ex) { error = ex.Message; }
    }
    private async Task CantonChangedAsync(ChangeEventArgs args)
    {
        form.Canton = args.Value?.ToString() is { Length: > 0 } s ? s : null; form.District = null; districts = [];
        if (form.Province is not null && form.Canton is not null) try { districts = await Locations.GetDistrictsAsync(form.Province, form.Canton); } catch (Exception ex) { error = ex.Message; }
    }
    private async Task SaveAsync()
    {
        if (!canEdit || saving || customer is null || (isNew && !customer.IsActive)) return;
        await RunAsync(async () =>
        {
            validationErrors.Clear();
            if (string.IsNullOrWhiteSpace(form.Name)) validationErrors.Add("Nombre: indique el nombre del proyecto.");
            if (form.Start.HasValue && form.End.HasValue && form.End < form.Start)
                validationErrors.Add("Fechas: la fecha final no puede ser anterior a la inicial.");
            if ((form.Province is not null || form.Canton is not null || form.District is not null) &&
                (form.Province is null || form.Canton is null || form.District is null))
                validationErrors.Add("Ubicación: indique provincia, cantón y distrito, o deje los tres vacíos.");
            if (form.AgreedAmount.HasValue != !string.IsNullOrWhiteSpace(form.Currency))
                validationErrors.Add("Monto inicial: registre monto y moneda juntos, o deje ambos sin definir.");
            if (form.Contacts.Count > 30) validationErrors.Add("Contactos: máximo 30 contactos.");
            for (var index = 0; index < form.Contacts.Count; index++)
            {
                var contact = form.Contacts[index];
                if (string.IsNullOrWhiteSpace(contact.Name) || string.IsNullOrWhiteSpace(contact.Role))
                    validationErrors.Add($"Contacto {index + 1}: complete el nombre y el rol, o quite la fila.");
            }
            if (validationErrors.Count > 0) return;
            var req = form.ToRequest(project?.Version);
            project = isNew ? await Api.CreateAsync(CustomerId, req) : await Api.UpdateAsync(project!.Id, req);
            if (isNew) Navigation.NavigateTo($"/projects/{project.Id}");
            else { await RefreshAsync(); showGeneralEditor = false; validationErrors.Clear(); }
        });
    }
    private async Task RefreshAsync()
    {
        if (project is null) return;
        project = await Api.GetAsync(project.Id);
        if (project is not null) { form = ProjectForm.From(project); balance = await Api.BalanceAsync(project.Id); isOwner = project.ResponsibleUserId == userId; target = project.Status == ProjectStatus.Completed ? ProjectStatus.Planning : project.Status; newAmount = project.AgreedAmount; newCurrency = project.CurrencyCode; }
    }
    private Task ChangeAmountAsync() => RunAsync(async () =>
    {
        if (project is null || string.IsNullOrWhiteSpace(amountReason)) throw new InvalidOperationException("Indique un motivo para cambiar el monto.");
        if ((newAmount is null) != string.IsNullOrWhiteSpace(newCurrency)) throw new InvalidOperationException("Monto y moneda deben indicarse juntos.");
        await Api.ChangeAgreedAmountAsync(project.Id, new(newAmount, newCurrency, project.Version, amountReason));
        await RefreshAsync(); CancelAmountEdit();
    });
    private Task TransitionAsync() => RunAsync(async () =>
    {
        if (project is null) return;
        await Api.TransitionAsync(project.Id, new(target, project.Version, reason)); await RefreshAsync(); reason = ""; CancelLifecycleEditor();
    });
    private Task CloseAsync() => RunAsync(async () =>
    {
        if (project is null) return;
        await Api.CloseAsync(project.Id, new(closedOn, closingNotes, null, project.Version)); await RefreshAsync(); CancelLifecycleEditor();
    });
    private Task ReopenAsync() => RunAsync(async () =>
    {
        if (project is null || string.IsNullOrWhiteSpace(reason)) throw new InvalidOperationException("Indique el motivo de reapertura.");
        await Api.ReopenAsync(project.Id, new(target, project.Version, reason)); await RefreshAsync(); reason = ""; CancelLifecycleEditor();
    });
    private Task ReassignAsync() => RunAsync(async () =>
    {
        if (!isAdmin || project is null || string.IsNullOrWhiteSpace(newResponsible)) throw new InvalidOperationException("Indique el usuario responsable.");
        await Api.ReassignAsync(project.Id, new(newResponsible.Trim(), project.Version)); await RefreshAsync(); newResponsible = ""; showReassignmentEditor = false;
    });
    private async Task RunAsync(Func<Task> work)
    {
        if (saving) return; saving = true; error = success = null;
        try { await work(); success = "Cambios guardados correctamente."; }
        catch (ProjectClientException ex) { error = ex.Message; if (ex.StatusCode == System.Net.HttpStatusCode.Conflict) error += " Recargue el expediente para obtener la versión actual."; }
        catch (Exception ex) { error = ex.Message; }
        finally { saving = false; }
    }
    private static string StatusLabel(ProjectStatus s) => s switch
    {
        ProjectStatus.Planning => "Planificación", ProjectStatus.PendingApproval => "Pendiente de aprobación",
        ProjectStatus.Active => "Activo", ProjectStatus.Paused => "Pausado", ProjectStatus.Completed => "Completado",
        ProjectStatus.Cancelled => "Cancelado", ProjectStatus.Archived => "Archivado", _ => s.ToString()
    };
    private sealed class ContactForm { public string Name { get; set; } = ""; public string Role { get; set; } = ""; public string? Phone { get; set; } public string? Email { get; set; } }
    private sealed class ProjectForm
    {
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string? Province { get; set; }
        public string? Canton { get; set; }
        public string? District { get; set; }
        public string? OtherSigns { get; set; }
        public DateOnly? Start { get; set; }
        public DateOnly? End { get; set; }
        public decimal? AgreedAmount { get; set; }
        public string? Currency { get; set; }
        public List<ContactForm> Contacts { get; set; } = [];
        public ProjectUpsertRequest ToRequest(long? version) => new(Name, Description, Province, Canton, District,
            OtherSigns, Start, End, AgreedAmount, Currency,
            Contacts.Select(x => new ProjectContactInput(x.Name, x.Role, x.Phone, x.Email)).ToList(), version);
        public static ProjectForm From(ProjectResponse p) => new()
        {
            Name = p.Name, Description = p.Description, Province = p.ProvinceCode, Canton = p.CantonCode,
            District = p.DistrictCode, OtherSigns = p.OtherSigns, Start = p.EstimatedStartDate,
            End = p.EstimatedEndDate, AgreedAmount = p.AgreedAmount, Currency = p.CurrencyCode,
            Contacts = p.Contacts.Select(x => new ContactForm { Name = x.Name, Role = x.Role, Phone = x.PhoneNumber, Email = x.Email }).ToList()
        };
    }
}

    private static string FormatHaciendaDetail(string detail)
    {
        if (string.IsNullOrWhiteSpace(detail)) return "Sin detalle adicional.";
        var value = detail.Trim().Trim('"');
        var firstQuote = value.IndexOf('"');
        var lastQuote = value.LastIndexOf('"');
        if (firstQuote >= 0 && lastQuote > firstQuote) return value[(firstQuote + 1)..lastQuote].Replace("\"\"", "\"").Trim();
        var parts = value.Split(',', StringSplitOptions.TrimEntries);
        return parts.Length >= 2 ? string.Join(",", parts.Skip(1).Take(Math.Max(1, parts.Length - 3))).Trim().Trim('"').Replace("\"\"", "\"") : value;
    }

    private static string FormatFileSize(long bytes) => bytes < 1024 ? $"{bytes} B" : bytes < 1024 * 1024 ? $"{bytes / 1024d:N1} KB" : $"{bytes / (1024d * 1024d):N1} MB";


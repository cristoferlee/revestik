        };
    }

    private static bool IsValidDateRange(DateOnly? dateFrom, DateOnly? dateTo) =>
        !dateFrom.HasValue ||
        !dateTo.HasValue ||
        dateFrom.Value <= dateTo.Value;

    private static string FormatDateRange(DateOnly? dateFrom, DateOnly? dateTo)
    {
        if (dateFrom.HasValue && dateTo.HasValue)
        {
            return $"{dateFrom.Value:dd/MM/yyyy} – {dateTo.Value:dd/MM/yyyy}";
        }

        if (dateFrom.HasValue)
        {
            return $"desde {dateFrom.Value:dd/MM/yyyy}";
        }

        if (dateTo.HasValue)
        {
            return $"hasta {dateTo.Value:dd/MM/yyyy}";
        }

        return "todo el historial";
    }


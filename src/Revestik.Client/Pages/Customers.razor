@page "/customers"
@using Revestik.Shared.Customers

<PageTitle>Clientes | Revestik</PageTitle>

<section class="customers-page">
    <header class="page-header">
        <div>
            <h1>Clientes</h1>
            <p>Administra la información de tus clientes.</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="status-message error-message" role="alert">
            @errorMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="status-message success-message" role="status">
            @successMessage
        </div>
    }

    <section class="customer-card"
             aria-labelledby="customer-form-title">
        <h2 id="customer-form-title">@FormTitle</h2>

        <EditForm Model="formModel"
                  OnValidSubmit="SaveCustomerAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-grid">
                <div class="form-group">
                    <label for="customer-name">Nombre</label>

                    <InputText id="customer-name"
                               @bind-Value="formModel.Name" />

                    <ValidationMessage
                        For="@(() => formModel.Name)" />
                </div>

                <div class="form-group">
                    <label for="customer-identification-type">
                        Tipo de identificación
                    </label>

                    <InputSelect id="customer-identification-type"
                                 @bind-Value="formModel.IdentificationType">
                        <option value="">
                            Seleccione un tipo de identificación
                        </option>

                        <option value="@IdentificationType.PhysicalPerson">
                            Cédula física
                        </option>

                        <option value="@IdentificationType.Dimex">
                            DIMEX
                        </option>

                        <option value="@IdentificationType.LegalEntity">
                            Cédula jurídica
                        </option>
                    </InputSelect>

                    <ValidationMessage
                        For="@(() => formModel.IdentificationType)" />
                </div>

                <div class="form-group form-wide">
                    <label for="customer-identification">
                        Cédula de identidad
                    </label>

                    <div class="identification-input-row">
                        <InputText id="customer-identification"
                                   inputmode="numeric"
                                   maxlength="@IdentificationMaximumLength"
                                   placeholder="@IdentificationPlaceholder"
                                   @bind-Value="formModel.IdentificationNumber" />

                        <button type="button"
                                class="secondary-button lookup-button"
                                disabled="@(!CanLookupTaxpayer || isLookingUpTaxpayer)"
                                @onclick="LookupTaxpayerAsync">
                            @(isLookingUpTaxpayer
                                ? "Consultando..."
                                : "Consultar en Hacienda")
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(IdentificationRule))
                    {
                        <p class="field-guidance">
                            @IdentificationRule
                        </p>
                    }

                    @if (!string.IsNullOrWhiteSpace(taxpayerLookupMessage))
                    {
                        <p class="@TaxpayerLookupMessageCssClass"
                           role="@TaxpayerLookupMessageRole">
                            @taxpayerLookupMessage
                        </p>
                    }

                    <ValidationMessage
                        For="@(() => formModel.IdentificationNumber)" />
                </div>

                <div class="form-group">
                    <label for="customer-email">
                        Correo electrónico
                    </label>

                    <InputText id="customer-email"
                               type="email"
                               @bind-Value="formModel.Email" />

                    <ValidationMessage
                        For="@(() => formModel.Email)" />
                </div>

                <div class="form-group">
                    <label for="customer-phone">
                        Teléfono
                    </label>

                    <InputText id="customer-phone"
                               type="tel"
                               @bind-Value="formModel.PhoneNumber" />

                    <ValidationMessage
                        For="@(() => formModel.PhoneNumber)" />
                </div>

                <fieldset class="address-section form-wide">
                    <legend>Dirección</legend>

                    <p class="field-guidance">
                        Selecciona la ubicación administrativa y agrega las
                        señas necesarias para localizar al cliente.
                    </p>

                    @if (!string.IsNullOrWhiteSpace(locationErrorMessage))
                    {
                        <p class="lookup-message lookup-error"
                           role="alert">
                            @locationErrorMessage
                        </p>
                    }

                    <div class="address-grid">
                        <div class="form-group">
                            <label for="customer-province">
                                Provincia
                            </label>

                            <select id="customer-province"
                                    value="@formModel.ProvinceCode"
                                    disabled="@isLoadingLocations"
                                    @onchange="OnProvinceChangedAsync">
                                <option value="">
                                    Seleccione una provincia
                                </option>

                                @foreach (var province in provinces)
                                {
                                    <option value="@province.Code">
                                        @province.Name
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="customer-canton">
                                Cantón
                            </label>

                            <select id="customer-canton"
                                    value="@formModel.CantonCode"
                                    disabled="@(!CanSelectCanton)"
                                    @onchange="OnCantonChangedAsync">
                                <option value="">
                                    Seleccione un cantón
                                </option>

                                @foreach (var canton in cantons)
                                {
                                    <option value="@canton.Code">
                                        @canton.Name
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="customer-district">
                                Distrito
                            </label>

                            <select id="customer-district"
                                    value="@formModel.DistrictCode"
                                    disabled="@(!CanSelectDistrict)"
                                    @onchange="OnDistrictChanged">
                                <option value="">
                                    Seleccione un distrito
                                </option>

                                @foreach (var district in districts)
                                {
                                    <option value="@district.Code">
                                        @district.Name
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="form-group form-wide">
                            <label for="customer-address">
                                Otras señas
                            </label>

                            <InputTextArea id="customer-address"
                                           rows="3"
                                           maxlength="160"
                                           placeholder="Ejemplo: 100 metros al norte de la iglesia, casa color blanco."
                                           @bind-Value="formModel.OtherSigns" />

                            <p class="field-guidance">
                                Escribe entre 5 y 160 caracteres.
                            </p>

                            <ValidationMessage
                                For="@(() => formModel.OtherSigns)" />
                        </div>
                    </div>
                </fieldset>

                <div class="form-group checkbox-group">
                    <InputCheckbox id="customer-active"
                                   @bind-Value="formModel.IsActive" />

                    <label for="customer-active">
                        Cliente activo
                    </label>
                </div>
            </div>

            <div class="form-actions">
                @if (editingCustomerId.HasValue)
                {
                    <button type="button"
                            class="secondary-button"
                            disabled="@isSaving"
                            @onclick="ResetForm">
                        Cancelar edición
                    </button>
                }

                <button type="submit"
                        class="primary-button"
                        disabled="@isSaving">
                    @(isSaving
                        ? "Guardando..."
                        : SaveButtonText)
                </button>
            </div>
        </EditForm>
    </section>

    <section class="customer-card"
             aria-labelledby="customer-list-title">
        <div class="list-header">
            <div>
                <h2 id="customer-list-title">
                    Lista de clientes
                </h2>

                <p>@CustomerCountText</p>
            </div>

            <div class="customer-list-filters">
                <div class="form-group">
                    <label for="customer-type-filter">
                        Tipo de identificación
                    </label>

                    <select id="customer-type-filter"
                            aria-label="Filtrar por tipo de identificación"
                            @onchange="OnIdentificationTypeFilterChangedAsync">
                        <option value="">
                            Todos
                        </option>

                        <option value="@IdentificationType.PhysicalPerson">
                            Cédula física
                        </option>

                        <option value="@IdentificationType.LegalEntity">
                            Cédula jurídica
                        </option>

                        <option value="@IdentificationType.Dimex">
                            DIMEX
                        </option>
                    </select>
                </div>

                <form class="search-form"
                      @onsubmit="SearchAsync"
                      @onsubmit:preventDefault>
                    <input type="search"
                           maxlength="150"
                           placeholder="Buscar por nombre"
                           aria-label="Buscar clientes por nombre"
                           @bind="searchTerm" />

                    <button type="submit"
                            class="primary-button"
                            disabled="@isLoading">
                        Buscar
                    </button>

                    @if (!string.IsNullOrWhiteSpace(searchTerm))
                    {
                        <button type="button"
                                class="secondary-button"
                                disabled="@isLoading"
                                @onclick="ClearSearchAsync">
                            Limpiar
                        </button>
                    }
                </form>
            </div>
        </div>

        @if (isLoading)
        {
            <p class="empty-state">
                Cargando clientes...
            </p>
        }
        else if (customers.Count == 0)
        {
            <p class="empty-state">
                No se encontraron clientes.
            </p>
        }
        else
        {
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Identificación</th>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Teléfono</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var customer in customers)
                        {
                            <tr>
                                <td data-label="Identificación">
                                    @customer.IdentificationNumber
                                </td>

                                <td data-label="Nombre">
                                    @customer.Name
                                </td>

                                <td data-label="Correo">
                                    @customer.Email
                                </td>

                                <td data-label="Teléfono">
                                    @customer.PhoneNumber
                                </td>

                                <td data-label="Estado">
                                    <span class="@GetStatusCssClass(customer)">
                                        @(customer.IsActive
                                            ? "Activo"
                                            : "Inactivo")
                                    </span>
                                </td>

                                <td data-label="Acciones">
                                    @if (customerPendingDeactivationId ==
                                         customer.Id)
                                    {
                                        <div class="action-buttons">
                                            <button type="button"
                                                    class="danger-button"
                                                    @onclick="() => DeactivateCustomerAsync(customer.Id)">
                                                Confirmar
                                            </button>

                                            <button type="button"
                                                    class="secondary-button"
                                                    @onclick="CancelDeactivation">
                                                Cancelar
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="action-buttons">
                                            <button type="button"
                                                    class="secondary-button"
                                                    @onclick="() => EditCustomerAsync(customer)">
                                                Editar
                                            </button>

                                            @if (customer.IsActive)
                                            {
                                                <button type="button"
                                                        class="danger-button"
                                                        @onclick="() => RequestDeactivation(customer.Id)">
                                                    Desactivar
                                                </button>
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <nav class="pagination-controls"
                 aria-label="Paginación de clientes">
                <button type="button"
                        class="secondary-button"
                        disabled="@(!CanGoToPreviousPage)"
                        @onclick="GoToPreviousPageAsync">
                    Anterior
                </button>

                <span aria-live="polite">
                    @PageDisplayText
                </span>

                <button type="button"
                        class="secondary-button"
                        disabled="@(!CanGoToNextPage)"
                        @onclick="GoToNextPageAsync">
                    Siguiente
                </button>
            </nav>
        }
    </section>
</section>
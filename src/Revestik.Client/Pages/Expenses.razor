@page "/expenses"
@using Revestik.Shared.Expenses
@using Revestik.Shared.Integrations.Gmail
@attribute [Authorize(Roles = "Administrator,Accountant")]

<PageTitle>Gastos | Revestik</PageTitle>

<section class="expenses-page">
    <header class="page-header">
        <div>
            <span class="section-kicker">Control de egresos</span>
            <h1>Gastos</h1>
            <p>Consolida gastos manuales, documentos electrónicos y vouchers bancarios sin duplicar el mismo egreso.</p>
        </div>

        <button type="button"
                class="primary-button"
                @onclick="ToggleForm">
            @(isFormOpen ? "Cerrar" : "+ Agregar gasto")
        </button>
    </header>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="status-message error-message" role="alert">@errorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="status-message success-message" role="status">@successMessage</div>
    }

    <nav class="module-nav" aria-label="Secciones de gastos">
        <button type="button"
                class="module-nav-button @(activeView == ExpenseView.Overview ? "active" : null)"
                @onclick="() => activeView = ExpenseView.Overview">
            Resumen
        </button>
        <button type="button"
                class="module-nav-button @(activeView == ExpenseView.Manual ? "active" : null)"
                @onclick="() => activeView = ExpenseView.Manual">
            Gastos manuales
        </button>
        <button type="button"
                class="module-nav-button @(activeView == ExpenseView.Vouchers ? "active" : null)"
                @onclick="() => activeView = ExpenseView.Vouchers">
            Vouchers
            @if (consolidatedSummary.NeedsReviewVoucherCount > 0)
            {
                <span class="nav-count">@consolidatedSummary.NeedsReviewVoucherCount</span>
            }
        </button>
    </nav>

    <section class="expense-card filters-card">
        <div class="filters-grid">
            <div class="form-group search-group">
                <label for="expense-search">Buscar gasto manual</label>
                <input id="expense-search"
                       type="search"
                       maxlength="150"
                       placeholder="Nombre o descripción"
                       @bind="listRequest.Search" />
            </div>
            <div class="form-group">
                <label for="expense-date-from">Desde</label>
                <InputDate id="expense-date-from" @bind-Value="listRequest.DateFrom" />
            </div>
            <div class="form-group">
                <label for="expense-date-to">Hasta</label>
                <InputDate id="expense-date-to" @bind-Value="listRequest.DateTo" />
            </div>
        </div>
        <div class="filter-actions">
            <button type="button"
                    class="secondary-button"
                    disabled="@isLoading"
                    @onclick="ClearFiltersAsync">
                Limpiar
            </button>
            <button type="button"
                    class="primary-button"
                    disabled="@isLoading"
                    @onclick="ApplyFiltersAsync">
                @(isLoading ? "Cargando..." : "Aplicar filtros")
            </button>
        </div>
    </section>

    @if (activeView == ExpenseView.Overview)
    {
        <section class="summary-grid" aria-label="Resumen consolidado">
            @if (consolidatedSummary.Totals.Count == 0)
            {
                <article class="summary-card">
                    <span>Total del período</span>
                    <strong>₡ 0.00</strong>
                    <small>Sin gastos contabilizados en el período.</small>
                </article>
            }
            else
            {
                @foreach (var total in consolidatedSummary.Totals)
                {
                    <article class="summary-card total-card">
                        <div class="summary-heading">
                            <span>Total real · @total.Currency</span>
                            <strong>@FormatMoney(total.Currency, total.Total)</strong>
                        </div>
                        <dl class="summary-breakdown">
                            <div><dt>Manuales</dt><dd>@FormatMoney(total.Currency, total.ManualExpenses)</dd></div>
                            <div><dt>Facturas Electronicas · gastos</dt><dd>@FormatMoney(total.Currency, total.ElectronicDocumentExpenses)</dd></div>
                            <div><dt>Vouchers aceptados</dt><dd>@FormatMoney(total.Currency, total.AcceptedBankVouchers)</dd></div>
                        </dl>
                    </article>
                }
            }

            <article class="summary-card review-card">
                <span>Vouchers por revisar</span>
                <strong>@consolidatedSummary.NeedsReviewVoucherCount</strong>
                <small>No se suman mientras estén pendientes.</small>
            </article>
        </section>

        <section class="expense-card">
            <div class="section-heading">
                <div>
                    <span class="section-kicker">Composición</span>
                    <h2>Cómo se calcula</h2>
                    <p>Gastos Manuales + Factura Electronica clasificada como gasto operativo + voucher aceptado sin factura vinculada.</p>
                </div>
            </div>

            <div class="status-grid">
                <div><span>Aceptados</span><strong>@consolidatedSummary.AcceptedVoucherCount</strong></div>
                <div><span>Vinculados</span><strong>@consolidatedSummary.MatchedVoucherCount</strong></div>
                <div><span>Ignorados</span><strong>@consolidatedSummary.IgnoredVoucherCount</strong></div>
                <div><span>Por revisar</span><strong>@consolidatedSummary.NeedsReviewVoucherCount</strong></div>
            </div>
        </section>
    }

    @if (isFormOpen)
    {
        <section class="expense-card">
            <div class="section-heading">
                <div>
                    <h2>Agregar gasto manual</h2>
                    <p>Úsalo para egresos que no cuentan con Factura Electronica ni voucher bancario que deba contabilizarse.</p>
                </div>
            </div>

            <EditForm Model="formModel" OnValidSubmit="SaveExpenseAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form-grid">
                    <div class="form-group">
                        <label>Nombre del gasto</label>
                        <InputText maxlength="150" @bind-Value="formModel.Name" />
                        <ValidationMessage For="@(() => formModel.Name)" />
                    </div>
                    <div class="form-group">
                        <label>Total con IVA</label>
                        <InputNumber min="0.01" step="0.01" @bind-Value="formModel.TotalAmount" />
                        <ValidationMessage For="@(() => formModel.TotalAmount)" />
                    </div>
                    <div class="form-group">
                        <label>Fecha</label>
                        <InputDate @bind-Value="formModel.ExpenseDate" />
                        <ValidationMessage For="@(() => formModel.ExpenseDate)" />
                    </div>
                    <div class="form-group form-wide">
                        <label>Descripción</label>
                        <InputTextArea rows="4" maxlength="1000" @bind-Value="formModel.Description" />
                        <ValidationMessage For="@(() => formModel.Description)" />
                    </div>
                </div>

                <div class="form-actions">
                    <button type="button"
                            class="secondary-button"
                            disabled="@isSaving"
                            @onclick="CloseForm">
                        Cancelar
                    </button>
                    <button type="submit"
                            class="primary-button"
                            disabled="@isSaving">
                        @(isSaving ? "Guardando..." : "Guardar gasto")
                    </button>
                </div>
            </EditForm>
        </section>
    }

    @if (activeView == ExpenseView.Manual)
    {
        <section class="expense-card">
            <div class="section-heading">
                <div>
                    <span class="section-kicker">Historial</span>
                    <h2>Gastos manuales</h2>
                    <p>Solo egresos registrados directamente en Revestik.</p>
                </div>
            </div>

            @if (isLoading)
            {
                <p class="empty-state">Cargando gastos...</p>
            }
            else if (expenses.Count == 0)
            {
                <p class="empty-state">No se encontraron gastos manuales.</p>
            }
            else
            {
                <div class="table-container">
                    <table>
                        <thead>
                            <tr><th>Fecha</th><th>Gasto</th><th>Descripción</th><th>Total</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var expense in expenses)
                            {
                                <tr>
                                    <td>@expense.ExpenseDate.ToString("dd/MM/yyyy")</td>
                                    <td><strong>@expense.Name</strong></td>
                                    <td>@expense.Description</td>
                                    <td>₡ @expense.TotalAmount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <nav class="pagination-controls">
                    <button type="button"
                            class="secondary-button"
                            disabled="@(!CanGoPrevious)"
                            @onclick="PreviousPageAsync">Anterior</button>
                    <span>Página @listRequest.Page de @totalPages</span>
                    <button type="button"
                            class="secondary-button"
                            disabled="@(!CanGoNext)"
                            @onclick="NextPageAsync">Siguiente</button>
                </nav>
            }
        </section>
    }

    @if (activeView == ExpenseView.Vouchers)
    {
        <section class="expense-card gmail-card">
            <div class="section-heading">
                <div>
                    <span class="section-kicker">Banco Nacional · Gmail</span>
                    <h2>Vouchers bancarios</h2>
                    <p>Sincroniza manualmente el buzón configurado. Los vouchers pendientes no afectan el total hasta que se revisen.</p>
                </div>
            </div>

            <div class="gmail-status-grid">
                <div><span>Cuenta esperada</span><strong>@gmailStatus.ExpectedMailbox</strong></div>
                <div><span>Estado</span><strong>@GetGmailStatusLabel()</strong></div>
                <div><span>Última sync</span><strong>@FormatSyncDate(gmailStatus.LastSuccessfulSyncUtc)</strong></div>
            </div>

            @if (!string.IsNullOrWhiteSpace(gmailStatus.LastSyncError))
            {
                <div class="status-message error-message">@gmailStatus.LastSyncError</div>
            }

            <div class="gmail-actions">
                <AuthorizeView Roles="Administrator">
                    @if (!gmailStatus.IsConnected)
                    {
                        <button type="button"
                                class="primary-button"
                                disabled="@isVoucherBusy"
                                @onclick="ConnectVoucherGmailAsync">
                            Conectar Google
                        </button>
                    }
                </AuthorizeView>

                @if (gmailStatus.IsConnected)
                {
                    <button type="button"
                            class="primary-button"
                            disabled="@isVoucherBusy"
                            @onclick="SyncVouchersAsync">
                        @(isVoucherBusy ? "Procesando..." : "Sincronizar ahora")
                    </button>
                }

                <AuthorizeView Roles="Administrator">
                    @if (gmailStatus.IsConnected)
                    {
                        <button type="button"
                                class="secondary-button"
                                disabled="@isVoucherBusy"
                                @onclick="DisconnectVoucherGmailAsync">
                            Desconectar
                        </button>
                    }
                </AuthorizeView>
            </div>
        </section>

        <section class="expense-card">
            <div class="section-heading">
                <div>
                    <span class="section-kicker">Vouchers</span>
                    <h2>@(activeVoucherView == VoucherView.Review ? "Pendientes de revisión" : "Historial")</h2>
                    <p>
                        @(activeVoucherView == VoucherView.Review
                            ? "Al aceptar, vincular o ignorar un voucher desaparece de esta cola y queda disponible en el historial."
                            : "Consulta vouchers ya aceptados, vinculados o ignorados.")
                    </p>
                </div>
            </div>

            <nav class="module-nav" aria-label="Vista de vouchers">
                <button type="button"
                        class="module-nav-button @(activeVoucherView == VoucherView.Review ? "active" : null)"
                        disabled="@isVoucherBusy"
                        @onclick="() => SelectVoucherViewAsync(VoucherView.Review)">
                    Por revisar
                    @if (consolidatedSummary.NeedsReviewVoucherCount > 0)
                    {
                        <span class="nav-count">@consolidatedSummary.NeedsReviewVoucherCount</span>
                    }
                </button>
                <button type="button"
                        class="module-nav-button @(activeVoucherView == VoucherView.History ? "active" : null)"
                        disabled="@isVoucherBusy"
                        @onclick="() => SelectVoucherViewAsync(VoucherView.History)">
                    Historial
                </button>
            </nav>

            @if (isVoucherBusy && VisibleVouchers.Count == 0)
            {
                <p class="empty-state">Cargando vouchers...</p>
            }
            else if (VisibleVouchers.Count == 0)
            {
                <p class="empty-state">
                    @(activeVoucherView == VoucherView.Review
                        ? "No hay vouchers pendientes de revisión en el período seleccionado."
                        : "No hay vouchers revisados en el período seleccionado.")
                </p>
            }
            else
            {
                <div class="voucher-list">
                    @foreach (var voucher in VisibleVouchers)
                    {
                        <article class="voucher-item">
                            <div class="voucher-main">
                                <div>
                                    <div class="voucher-title-row">
                                        <strong>@voucher.MerchantName</strong>
                                        <span class="status-badge @GetVoucherStatusClass(voucher.Status)">
                                            @GetVoucherStatusLabel(voucher.Status)
                                        </span>
                                    </div>
                                    <small>
                                        @voucher.TransactionDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        · @(voucher.CardBrand ?? "Tarjeta")
                                        @if (!string.IsNullOrWhiteSpace(voucher.CardLastFour))
                                        {
                                            <text> ****@voucher.CardLastFour</text>
                                        }
                                    </small>
                                    @if (!string.IsNullOrWhiteSpace(voucher.ReferenceNumber))
                                    {
                                        <small>Ref. @voucher.ReferenceNumber</small>
                                    }
                                </div>
                                <strong class="voucher-amount">@FormatMoney(voucher.Currency, voucher.Amount)</strong>
                            </div>

                            @if (voucher.Status == BankVoucherStatus.NeedsReview)
                            {
                                <div class="review-warning">
                                    <strong>Confirmar aceptación del voucher</strong>
                                    @if (voucher.MatchCandidates.Count > 0)
                                    {
                                        <p>Encontramos una factura electrónica con monto, fecha y comercio compatibles. Revisa ambos registros antes de decidir.</p>
                                    }
                                    else if (voucher.IsKnownMerchant)
                                    {
                                        <p>Este comercio coincide con un proveedor/emisor conocido. Es posible que posteriormente se reciba una factura electrónica. Confirma que este voucher debe contabilizarse por separado antes de aceptarlo.</p>
                                    }
                                    else
                                    {
                                        <p>No encontramos una factura relacionada actualmente. Confirma que este voucher representa un gasto que debe contabilizarse.</p>
                                    }
                                </div>

                                @if (voucher.MatchCandidates.Count > 0)
                                {
                                    <div class="candidate-list">
                                        @foreach (var candidate in voucher.MatchCandidates)
                                        {
                                            <div class="candidate-row">
                                                <div>
                                                    <strong>@candidate.IssuerName</strong>
                                                    <small>@candidate.IssueDate.ToLocalTime().ToString("dd/MM/yyyy") · @FormatMoney(candidate.Currency, candidate.TotalAmount)</small>
                                                    @if (!string.IsNullOrWhiteSpace(candidate.CategoryName))
                                                    {
                                                        <small>@candidate.CategoryName</small>
                                                    }
                                                </div>
                                                <button type="button"
                                                        class="secondary-button"
                                                        disabled="@isVoucherBusy"
                                                        @onclick="() => MatchVoucherAsync(voucher.Id, candidate.ElectronicDocumentId)">
                                                    Vincular con factura
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }

                                <div class="voucher-actions">
                                    <button type="button"
                                            class="primary-button"
                                            disabled="@isVoucherBusy"
                                            @onclick="() => AcceptVoucherAsync(voucher.Id)">
                                        Aceptar voucher
                                    </button>
                                    <button type="button"
                                            class="secondary-button"
                                            disabled="@isVoucherBusy"
                                            @onclick="() => IgnoreVoucherAsync(voucher.Id)">
                                        Ignorar
                                    </button>
                                </div>
                            }
                            else if (voucher.Status == BankVoucherStatus.Matched)
                            {
                                <p class="voucher-note">Vinculado a documento electrónico #@voucher.MatchedElectronicDocumentId. No se suma por separado.</p>
                            }
                            else if (voucher.Status == BankVoucherStatus.Accepted)
                            {
                                <p class="voucher-note">Contabilizado como gasto bancario independiente.</p>
                            }
                            else
                            {
                                <p class="voucher-note">No se contabiliza en los totales.</p>
                            }
                        </article>
                    }
                </div>

                <nav class="pagination-controls">
                    <button type="button"
                            class="secondary-button"
                            disabled="@(!CanGoPreviousVoucher)"
                            @onclick="PreviousVoucherPageAsync">
                        Anterior
                    </button>
                    <span>Página @ActiveVoucherRequest.Page de @ActiveVoucherTotalPages</span>
                    <button type="button"
                            class="secondary-button"
                            disabled="@(!CanGoNextVoucher)"
                            @onclick="NextVoucherPageAsync">
                        Siguiente
                    </button>
                </nav>
            }
        </section>
    }
</section>

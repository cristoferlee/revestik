    private async Task LoadPeriodAsync()
    {
        isLoadingPeriod = true;
        periodError = null;
        try
        {
            var localNow = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow,
                TimeZoneInfo.FindSystemTimeZoneById("America/Costa_Rica"));
            periodTitle = localNow.ToString("MMMM yyyy",
                System.Globalization.CultureInfo.GetCultureInfo("es-CR"));
            periodSummary = await SaleApiService.GetPeriodSummaryAsync(localNow.Year, localNow.Month);
        }
        catch (HttpRequestException)
        {
            periodError = "No fue posible consultar la actividad comercial mensual.";
        }
        catch (System.Text.Json.JsonException)
        {
            periodError = "La respuesta del resumen mensual no tiene el formato esperado.";
        }
        catch (InvalidOperationException)
        {
            periodError = "La API no devolvió un resumen mensual válido.";
        }
        finally
        {
            isLoadingPeriod = false;
        }
    }

    private async Task LoadAlertsAsync()
    {
        isLoadingAlerts = true;
        alertError = null;
        try
        {
            using var response = await Http.GetAsync("api/dashboard/project-alerts");
            if (response.IsSuccessStatusCode)
            {
                alerts = await response.Content.ReadFromJsonAsync<List<ProjectDashboardAlertResponse>>() ?? [];
                // The API calculates the business-day window in Costa Rica; the earliest
                // non-overdue due date is not used to infer the current day here.
                today = DateOnly.FromDateTime(TimeZoneInfo.ConvertTimeFromUtc(
                    DateTime.UtcNow, TimeZoneInfo.FindSystemTimeZoneById("America/Costa_Rica")));
            }
            else
            {
                alertError = "No fue posible consultar las alertas de proyectos.";
            }
        }
        catch (HttpRequestException)
        {
            alertError = "No fue posible conectar con el servicio de alertas.";
        }
        catch (System.Text.Json.JsonException)
        {
            alertError = "La respuesta de alertas no tiene el formato esperado.";
        }
        finally
        {
            isLoadingAlerts = false;
        }
    }
}

@page "/"
@using System.Net
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using Revestik.Client.Services.Sales
@using Revestik.Client.Services.Purchases
@using Revestik.Client.Components.Dashboard
@using Revestik.Shared.Dashboard
@using Revestik.Shared.Projects
@using Revestik.Shared.Sales
@using Revestik.Shared.Purchases
@using Revestik.Shared.Expenses
@using Revestik.Shared.Inventory
@using Revestik.Shared.ElectronicDocuments
@using Revestik.Client.Services.Inventory
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationState
@inject ISaleApiService SaleApiService
@inject IPurchaseApiService PurchaseApiService
@inject IInventoryApiService InventoryApiService

<PageTitle>Dashboard | Revestik</PageTitle>

<section class="dashboard-page">
    <header class="page-header dashboard-hero">
        <div>
            <span class="dashboard-eyebrow">PANEL DE CONTROL</span>
            <h1>Dashboard</h1>
            <p>Resumen general de la operación de Revestik</p>
        </div>
        <div class="dashboard-toolbar">
            <label for="dashboard-currency">Moneda de indicadores</label>
            <select id="dashboard-currency" @bind="selectedDashboardCurrency" aria-label="Moneda de los indicadores principales">
                <option value="CRC">CRC · Colones</option>
                <option value="USD">USD · Dólares</option>
            </select>
            <button type="button" class="dashboard-refresh dashboard-update" @onclick="LoadResultsAsync" disabled="@(isLoadingGrossMargin || isLoadingOperatingResult)">Actualizar resultados</button>
        </div>
    </header>

    <section class="dashboard-overview" aria-labelledby="overview-title">
        <div class="dashboard-overview-heading">
            <div>
                <h2 id="overview-title">Indicadores principales</h2>
                <p>Importes separados por moneda. Los resultados del mes son estimaciones y pueden requerir revisión.</p>
            </div>
            <span class="dashboard-currency-tag">@selectedDashboardCurrency</span>
        </div>
        <div class="dashboard-overview-main">
        <div class="dashboard-overview-grid">
            <article class="dashboard-overview-card dashboard-selectable @DashboardFinancialState(!isLoadingGrossMargin && grossMarginError is null ? grossMarginSummary?.Currencies.FirstOrDefault(x => x.Currency.ToString() == selectedDashboardCurrency)?.EstimatedCommercialResult : null, grossMarginSummary?.Currencies.FirstOrDefault(x => x.Currency.ToString() == selectedDashboardCurrency)?.RequiresReview == true) dashboard-overview-result">
                <button type="button" class="dashboard-card-action" aria-label="Abrir detalle de commercial" aria-controls="dashboard-detail" aria-expanded='@(selectedDashboardDetail == "commercial")' @onclick='() => SelectDashboardDetail("commercial")'></button>
                <span class="dashboard-overview-icon" aria-hidden="true">▥</span>
                <h3>Resultado comercial estimado</h3>
                @if (isLoadingGrossMargin) { <span role="status">Cargando...</span> }
                else if (grossMarginError is not null) { <span role="alert">No disponible</span> }
                else if (grossMarginSummary?.Currencies.FirstOrDefault(x => x.Currency.ToString() == selectedDashboardCurrency) is { } commercial)
                { <strong>@FormatAmount(commercial.EstimatedCommercialResult)</strong> }
                else { <strong>—</strong> }
                <small>Mes actual · sin IVA · @selectedDashboardCurrency</small>
            </article>
            <article class="dashboard-overview-card dashboard-selectable @DashboardFinancialState(!isLoadingOperatingResult && operatingResultError is null ? operatingResult?.Currencies.FirstOrDefault(x => x.Currency.ToString() == selectedDashboardCurrency)?.EstimatedOperatingResult : null, operatingResult?.Currencies.FirstOrDefault(x => x.Currency.ToString() == selectedDashboardCurrency)?.RequiresReview == true) dashboard-overview-result">
                <button type="button" class="dashboard-card-action" aria-label="Abrir detalle de operating" aria-controls="dashboard-detail" aria-expanded='@(selectedDashboardDetail == "operating")' @onclick='() => SelectDashboardDetail("operating")'></button>
                <span class="dashboard-overview-icon" aria-hidden="true">▤</span>
                <h3>Resultado operativo estimado</h3>
                @if (isLoadingOperatingResult) { <span role="status">Cargando...</span> }
                else if (operatingResultError is not null) { <span role="alert">No disponible</span> }
                else if (operatingResult?.Currencies.FirstOrDefault(x => x.Currency.ToString() == selectedDashboardCurrency) is { } operating)
                { <strong>@FormatAmount(operating.EstimatedOperatingResult)</strong> }
                else { <strong>—</strong> }
                <small>Mes actual · @selectedDashboardCurrency</small>
            </article>
            <AuthorizeView Roles="Administrator,Accountant,Sales">
                <Authorized>
                    <article class="dashboard-overview-card dashboard-selectable @DashboardSalesState()">
                <button type="button" class="dashboard-card-action" aria-label="Abrir detalle de sales" aria-controls="dashboard-detail" aria-expanded='@(selectedDashboardDetail == "sales")' @onclick='() => SelectDashboardDetail("sales")'></button>
                        <span class="dashboard-overview-icon" aria-hidden="true">↗</span>
                        <h3>Ventas vigentes</h3>
                        @if (isLoadingSales) { <span role="status">Cargando...</span> }
                        else if (salesError is not null) { <span role="alert">No disponible</span> }
                        else { <strong>@FormatAmount(SalesCurrencies.First(x => x.Currency.ToString() == selectedDashboardCurrency).SoldTotal)</strong> }
                        <small>Ver historial de ventas · abrir detalle</small>
                    </article>
                    <article class="dashboard-overview-card dashboard-selectable">
                <button type="button" class="dashboard-card-action" aria-label="Abrir detalle de receivables" aria-controls="dashboard-detail" aria-expanded='@(selectedDashboardDetail == "receivables")' @onclick='() => SelectDashboardDetail("receivables")'></button>
                        <span class="dashboard-overview-icon" aria-hidden="true">₡</span>
                        <h3>Cuentas por cobrar</h3>
                        @if (isLoadingSales) { <span role="status">Cargando...</span> }
                        else if (salesError is not null) { <span role="alert">No disponible</span> }
                        else { <strong>@FormatAmount(SalesCurrencies.First(x => x.Currency.ToString() == selectedDashboardCurrency).OutstandingTotal)</strong> }
                        <small>Ver saldos · abrir detalle</small>
                    </article>
                </Authorized>
            </AuthorizeView>
            <article class="dashboard-overview-card dashboard-selectable @DashboardPayablesState()">
                <button type="button" class="dashboard-card-action" aria-label="Abrir detalle de payables" aria-controls="dashboard-detail" aria-expanded='@(selectedDashboardDetail == "payables")' @onclick='() => SelectDashboardDetail("payables")'></button>
                <span class="dashboard-overview-icon" aria-hidden="true">⇣</span>
                <h3>Cuentas por pagar</h3>
                @if (isLoadingPayables) { <span role="status">Cargando...</span> }
                else if (payablesError is not null) { <span role="alert">No disponible</span> }
                else { <strong>@FormatAmount(PayableCurrencies.First(x => x.Currency.ToString() == selectedDashboardCurrency).OutstandingTotal)</strong> }
                <small>Ver obligaciones · abrir detalle</small>
            </article>
            <article class="dashboard-overview-card dashboard-selectable @DashboardInventoryState()">
                <button type="button" class="dashboard-card-action" aria-label="Abrir detalle de inventory" aria-controls="dashboard-detail" aria-expanded='@(selectedDashboardDetail == "inventory")' @onclick='() => SelectDashboardDetail("inventory")'></button>
                <span class="dashboard-overview-icon" aria-hidden="true">◇</span>
                <h3>Inventario actual</h3>
                @if (isLoadingInventory) { <span role="status">Cargando...</span> }
                else if (inventoryError is not null) { <span role="alert">No disponible</span> }
                else if (selectedDashboardCurrency == "CRC" && inventorySummary is not null)
                { <strong>@FormatAmount(inventorySummary.TotalInventoryCostValue)</strong> }
                else { <strong>—</strong> }
                <small>@(selectedDashboardCurrency == "CRC" ? "Valor conocido al costo" : "Valor del inventario disponible en CRC") · abrir detalle</small>
            </article>
            <AuthorizeView Roles="Administrator,Accountant,Sales">
                <Authorized>
                    <article class="dashboard-overview-card dashboard-selectable @DashboardProjectsState()">
                <button type="button" class="dashboard-card-action" aria-label="Abrir detalle de projects" aria-controls="dashboard-detail" aria-expanded='@(selectedDashboardDetail == "projects")' @onclick='() => SelectDashboardDetail("projects")'></button>
                        <span class="dashboard-overview-icon" aria-hidden="true">▣</span>
                        <h3>Proyectos abiertos</h3>
                        @if (isLoadingProjects) { <span role="status">Cargando...</span> }
                        else if (projectsError is not null) { <span role="alert">No disponible</span> }
                        else { <strong>@(projectsSummary?.OpenCount.ToString() ?? "—")</strong> }
                        <small>Ver proyectos · abrir detalle</small>
                    </article>
                </Authorized>
            </AuthorizeView>
            <article class="dashboard-overview-card dashboard-selectable">
                <button type="button" class="dashboard-card-action" aria-label="Abrir calculadora de divisas" aria-controls="dashboard-detail" aria-expanded='@(selectedDashboardDetail == "fx")' @onclick='() => SelectDashboardDetail("fx")'></button>
                <span class="dashboard-overview-icon" aria-hidden="true">⇄</span>
                <h3>Cambio de divisas</h3>
                @if (fxLoading) { <span role="status">Consultando BCCR...</span> }
                else if (fxRates is null) { <strong>Sin cotización</strong> }
                else { <strong>₡@fxRates.PurchaseRate.ToString("N2", RecentCulture) / ₡@fxRates.SaleRate.ToString("N2", RecentCulture)</strong> }
                <small>Compra / venta BCCR · abrir calculadora</small>
            </article>
        </div>

    <aside class="dashboard-overview-side" aria-label="Seguimiento inmediato">
        <article class="dashboard-panel">
            <h2>Alertas</h2>
            <h3 class="dashboard-alert-subheading">Proyectos</h3>
            <AuthorizeView Roles="Administrator,Accountant,Sales">
                <Authorized>
                    @if (isLoadingAlerts)
                    {
                        <p role="status">Cargando alertas de proyectos...</p>
                    }
                    else if (alertError is not null)
                    {
                        <p role="alert">@alertError</p>
                        <button type="button" class="dashboard-refresh" @onclick="LoadAlertsAsync">Reintentar</button>
                    }
                    else if (alerts.Count == 0)
                    {
                        <p>No hay vencimientos pendientes o próximos en los siguientes 7 días.</p>
                    }
                    else
                    {
                        <div class="project-alert-counts" aria-label="Resumen de vencimientos">
                            <span><strong>@alerts.Count(x => x.IsOverdue)</strong> vencidas</span>
                            <span><strong>@alerts.Count(x => x.DueOn == today)</strong> vencen hoy</span>
                            <span><strong>@alerts.Count(x => x.DueOn > today)</strong> próximas</span>
                        </div>
                        <ul class="project-alert-list">
                            @foreach (var alert in alerts)
                            {
                                <li class="project-alert-item @(alert.IsOverdue ? "is-overdue" : "is-upcoming")">
                                    <span class="project-alert-kind"><span class="dashboard-alert-state-icon" aria-hidden="true">●</span> @(alert.Kind == "Task" ? "Tarea" : "Evento / compromiso")</span>
                                    <strong>@alert.Title</strong>
                                    <span>@alert.ProjectName</span>
                                    <time datetime="@alert.DueOn.ToString("yyyy-MM-dd")">
                                        @(alert.IsOverdue ? "Vencida" : alert.DueOn == today ? "Vence hoy" : "Vence") · @alert.DueOn.ToString("dd/MM/yyyy")
                                    </time>
                                </li>
                            }
                        </ul>
                    }
                </Authorized>
                <NotAuthorized>
                    <p>Las alertas de proyectos están disponibles para usuarios autorizados.</p>
                </NotAuthorized>
            </AuthorizeView>
            <h3 class="dashboard-alert-subheading">Proveedores</h3>
            @if (isLoadingPurchaseAlerts)
            {
                <p role="status">Cargando alertas de proveedores...</p>
            }
            else if (purchaseAlertsError is not null)
            {
                <p role="alert">@purchaseAlertsError</p>
                <button type="button" class="dashboard-refresh" @onclick="LoadPurchaseAlertsAsync">Reintentar</button>
            }
            else if (purchaseAlerts.Count == 0)
            {
                <p>No hay pagos a proveedores vencidos o próximos en los siguientes 7 días.</p>
            }
            else
            {
                <div class="project-alert-counts" aria-label="Resumen de alertas de proveedores">
                    <span><strong>@purchaseAlerts.Count(x => x.DaysUntilDue < 0)</strong> vencidas</span>
                    <span><strong>@purchaseAlerts.Count(x => x.DaysUntilDue == 0)</strong> vencen hoy</span>
                    <span><strong>@purchaseAlerts.Count(x => x.DaysUntilDue > 0)</strong> próximas</span>
                </div>
                <ul class="project-alert-list">
                    @foreach (var alert in purchaseAlerts)
                    {
                        <li class="project-alert-item @(alert.DaysUntilDue < 0 ? "is-overdue" : "is-upcoming")">
                            <span class="project-alert-kind"><span class="dashboard-alert-state-icon" aria-hidden="true">●</span> Proveedor · @alert.Currency</span>
                            <strong>@alert.SupplierName</strong>
                            <span>Saldo: @FormatAmount(alert.OutstandingAmount) · Compra #@alert.PurchaseId</span>
                            <time datetime="@alert.DueDate.ToString("yyyy-MM-dd")">
                                @(alert.DaysUntilDue < 0 ? "Vencida" : alert.DaysUntilDue == 0 ? "Vence hoy" : "Vence") · @alert.DueDate.ToString("dd/MM/yyyy")
                            </time>
                        </li>
                    }
                </ul>
            }
        </article>

        <article class="dashboard-panel dashboard-recent-panel" aria-labelledby="recent-activity-title">
            <div class="dashboard-recent-heading">
                <h2 id="recent-activity-title">Actividad reciente</h2>
                <button type="button" class="dashboard-refresh" disabled="@isLoadingRecent" @onclick="LoadRecentActivityAsync" aria-label="Actualizar actividad reciente">Actualizar</button>
            </div>
            @if (isLoadingRecent)
            {
                <p role="status">Cargando actividad reciente...</p>
            }
            else if (recentActivityError is not null)
            {
                <p role="alert">@recentActivityError</p>
                <button type="button" class="dashboard-refresh" @onclick="LoadRecentActivityAsync">Reintentar</button>
            }
            else if (recentActivities.Count == 0)
            {
                <p>No hay actividad reciente disponible para tu perfil.</p>
            }
            else
            {
                <ol class="dashboard-recent-list" aria-label="Últimos movimientos">
                    @foreach (var activity in recentActivities)
                    {
                        <li class="dashboard-recent-item">
                            <span class="dashboard-recent-symbol" aria-hidden="true">@GetActivitySymbol(activity.Kind)</span>
                            <div class="dashboard-recent-content">
                                <strong>@activity.Title</strong>
                                <span>@activity.Description</span>
                                <time datetime="@activity.OccurredAtUtc.ToString("O")">@FormatRecentDate(activity.OccurredAtUtc)</time>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(activity.Path))
                            {
                                <a href="@activity.Path" aria-label="Ver @activity.Title" class="dashboard-recent-link">Ver <span aria-hidden="true">→</span></a>
                            }
                        </li>
                    }
                </ol>
            }
        </article>
    </aside>

        </div>
    </section>


    <section class="dashboard-analysis-grid" aria-label="Análisis del negocio">
    <section class="dashboard-trend-panel dashboard-analysis-card" aria-labelledby="dashboard-trend-title">
        <div class="dashboard-trend-head">
            <div>
                <h2 id="dashboard-trend-title">Actividad comercial diaria</h2>
                <p>Ventas, cobros y compras internas por día. Las compras desde XML se informan por separado.</p>
            </div>
            <div class="dashboard-trend-controls">
                <label for="trend-month">Mes</label>
                <select id="trend-month" @bind="trendMonth" @bind:after="LoadTrendAsync">
                    @foreach (var m in Enumerable.Range(1, 12))
                    {
                        <option value="@m">@System.Globalization.CultureInfo.GetCultureInfo("es-CR").DateTimeFormat.GetMonthName(m)</option>
                    }
                </select>
                <label for="trend-year">Año</label>
                <select id="trend-year" @bind="trendYear" @bind:after="LoadTrendAsync">
                    @foreach (var year in Enumerable.Range(DateTime.UtcNow.Year - 4, 5).Reverse())
                    {
                        <option value="@year">@year</option>
                    }
                </select>
                <label for="trend-currency">Moneda</label>
                <select id="trend-currency" @bind="trendCurrency"><option value="CRC">CRC</option><option value="USD">USD</option></select>
            </div>
        </div>
        <AuthorizeView Roles="Administrator,Accountant,Sales">
            <Authorized>
                @if (isLoadingTrend) { <p role="status">Cargando actividad diaria...</p> }
                else if (trendError is not null)
                {
                    <p role="alert">@trendError</p>
                    <button class="dashboard-refresh" type="button" @onclick="LoadTrendAsync">Reintentar</button>
                }
                else if (trendResponse is not null)
                {
                    <DashboardActivityChart Days="@(trendResponse.Currencies.FirstOrDefault(x => x.Currency == trendCurrency)?.Days ?? [])" />
                }
            </Authorized>
            <NotAuthorized><p>Información comercial disponible para usuarios autorizados.</p></NotAuthorized>
        </AuthorizeView>
        <p class="dashboard-period-note">Ventas emitidas vigentes, pagos activos por fecha de cobro y compras registradas internamente. Son importes por fuente, no un resultado contable consolidado.</p>
    </section>


    <section class="dashboard-analysis-card" aria-labelledby="dashboard-analysis-commercial-title">
        <div class="dashboard-analysis-heading">
            <h2 id="dashboard-analysis-commercial-title">Resultado comercial estimado</h2>
            <p>Ventas sin IVA menos compras directas documentadas y costo conocido de inventario.</p>
        </div>
        @if (isLoadingGrossMargin)
        {
            <p role="status">Cargando resultado...</p>
        }
        else if (grossMarginError is not null)
        {
            <p role="alert">@grossMarginError</p>
        }
        else if (grossMarginSummary?.Currencies.FirstOrDefault(x => x.Currency.ToString() == selectedDashboardCurrency) is { } resultChart)
        {
            var maxComponent = new[] { Math.Abs(resultChart.AllSalesLineRevenue), Math.Abs(resultChart.DirectPurchaseBase), Math.Abs(resultChart.VerifiedFifoCost) }.Max();
            <div class="dashboard-analysis-sum" aria-label="Resultado comercial estimado, @selectedDashboardCurrency">
                <strong>@FormatAmount(resultChart.EstimatedCommercialResult)</strong>
                <span>@selectedDashboardCurrency · Mes actual</span>
            </div>
            <div class="dashboard-analysis-bars" role="img" aria-label="Comparación de ingresos y costos comerciales del mes">
                @foreach (var bar in new[] {
                    (Label: "Ventas sin IVA", Amount: resultChart.AllSalesLineRevenue, Style: "income"),
                    (Label: "Compras directas XML", Amount: resultChart.DirectPurchaseBase, Style: "purchase"),
                    (Label: "Costo de inventario vendido", Amount: resultChart.VerifiedFifoCost, Style: "inventory") })
                {
                    <div class="dashboard-analysis-bar-row">
                        <div class="dashboard-analysis-bar-label"><span>@bar.Label</span><strong>@FormatAmount(bar.Amount)</strong></div>
                        <div class="dashboard-analysis-bar-track"><div class="dashboard-analysis-bar-fill @bar.Style" style="width:@BarPercent(bar.Amount, maxComponent)"></div></div>
                    </div>
                }
            </div>
            @if (resultChart.RequiresReview)
            {
                <p class="dashboard-analysis-caution" role="status">Estimación parcial: hay datos o documentos por revisar.</p>
            }
            <button type="button" class="dashboard-analysis-open" @onclick='() => SelectDashboardDetail("commercial")'>Ver cálculo y advertencias →</button>
        }
        <p class="dashboard-period-note">No representa utilidad contable ni fiscal definitiva. No suma compras internas a los XML.</p>
    </section>

    <section class="dashboard-analysis-card" aria-labelledby="dashboard-analysis-projects-title">
        <div class="dashboard-analysis-heading">
            <h2 id="dashboard-analysis-projects-title">Proyectos por estado</h2>
            <p>Distribución real de expedientes registrados.</p>
        </div>
        @if (isLoadingProjects)
        {
            <p role="status">Cargando proyectos...</p>
        }
        else if (projectsError is not null)
        {
            <p role="alert">@projectsError</p>
        }
        else if (projectsSummary is not null)
        {
            <div class="dashboard-analysis-sum"><strong>@projectsSummary.TotalCount</strong><span>Proyectos registrados</span></div>
            <div class="dashboard-analysis-bars" role="img" aria-label="Cantidad de proyectos por estado">
                @foreach (var status in new[] {
                    (Label: "Planificación", Count: projectsSummary.PlanningCount, Style: "planning"),
                    (Label: "Pendiente de aprobación", Count: projectsSummary.PendingApprovalCount, Style: "approval"),
                    (Label: "En ejecución", Count: projectsSummary.ActiveCount, Style: "active"),
                    (Label: "Pausados", Count: projectsSummary.PausedCount, Style: "paused"),
                    (Label: "Finalizados", Count: projectsSummary.CompletedCount, Style: "completed"),
                    (Label: "Cancelados", Count: projectsSummary.CancelledCount, Style: "cancelled"),
                    (Label: "Archivados", Count: projectsSummary.ArchivedCount, Style: "archived") })
                {
                    <div class="dashboard-analysis-bar-row">
                        <div class="dashboard-analysis-bar-label"><span>@status.Label</span><strong>@status.Count</strong></div>
                        <div class="dashboard-analysis-bar-track"><div class="dashboard-analysis-bar-fill @status.Style" style="width:@BarPercent(status.Count, projectsSummary.TotalCount)"></div></div>
                    </div>
                }
            </div>
            <button type="button" class="dashboard-analysis-open" @onclick='() => SelectDashboardDetail("projects")'>Ver detalle de proyectos →</button>
        }
    </section>
    </section>

    @if (selectedDashboardDetail is not null)
    {
        <div class="dashboard-modal-overlay">
            <button type="button" class="dashboard-modal-backdrop"
                    aria-label="Cerrar el detalle" @onclick="CloseDashboardDetail"></button>
            <section id="dashboard-detail" class="dashboard-active-detail dashboard-modal-dialog"
                     role="dialog" aria-modal="true" aria-labelledby="dashboard-modal-title"
                     tabindex="-1" @onkeydown="HandleDashboardModalKeyDown">
            <header class="dashboard-detail-toolbar">
                <div>
                    <span class="dashboard-eyebrow">DETALLE DEL INDICADOR</span>
                    <h2 id="dashboard-modal-title">@SelectedDashboardDetailTitle</h2>
                </div>
                <div class="dashboard-detail-actions">
                    @if (selectedDashboardDetail != "fx")
                    {
                        <a class="dashboard-detail-link" href="@SelectedDashboardDetailUrl">@SelectedDashboardDetailAction →</a>
                    }
                    <button type="button" class="dashboard-refresh" @onclick="CloseDashboardDetail">Cerrar detalle</button>
                </div>
            </header>
            @if (selectedDashboardDetail == "fx")
            {
                <div class="fx-calculator">
                    <p class="dashboard-period-note">Referencia informativa del Banco Central de Costa Rica. Las cotizaciones bancarias reales y comisiones pueden variar.</p>
                    @if (fxLoading) { <p role="status">Consultando tipos de cambio...</p> }
                    else if (fxError is not null || fxRates is null)
                    {
                        <p role="alert">@fxError</p>
                        <button type="button" class="dashboard-refresh" @onclick="LoadFxAsync">Reintentar</button>
                    }
                    else
                    {
                        <div class="fx-rates">
                            <div><span>Compra BCCR</span><strong>₡@fxRates.PurchaseRate.ToString("N2", RecentCulture)</strong></div>
                            <div><span>Venta BCCR</span><strong>₡@fxRates.SaleRate.ToString("N2", RecentCulture)</strong></div>
                        </div>
                        <p class="dashboard-period-note">Vigencia: @fxRates.EffectiveDate.ToString("dd/MM/yyyy") · @(fxRates.IsStale ? "Cotización de fecha anterior; confirmar antes de operar." : "Cotización del día.") @(fxRates.IsCached ? "Dato conservado en caché." : "")</p>
                        <label for="fx-operation">Operación comercial</label>
                        <select id="fx-operation" @bind="fxOperation">
                            <option value="ReceiveUsd">Venta en CRC, cliente paga en USD</option>
                            <option value="ReceiveCrc">Venta en USD, cliente paga en CRC</option>
                            <option value="ExchangeUsd">Convertir USD propios a CRC (estimación)</option>
                            <option value="BuyUsd">Comprar USD con CRC (presupuesto)</option>
                        </select>
                        <label for="fx-amount">Importe (@FxInputCurrency)</label>
                        <input id="fx-amount" type="number" min="0" max="100000000000" step="0.01" @bind="fxAmount" />
                        <label for="fx-protection">Ajuste comercial de protección</label>
                        <select id="fx-protection" @bind="fxProtection">

    protected override async Task OnInitializedAsync()
    {
        // Sales and project alerts currently share the same authorized role set.
        var state = await AuthenticationState.GetAuthenticationStateAsync();
        var user = state.User;
        if (user.Identity?.IsAuthenticated != true)
            return;

        var nowCr = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, TimeZoneInfo.FindSystemTimeZoneById("America/Costa_Rica"));
        trendYear = nowCr.Year;
        trendMonth = nowCr.Month;
        var tasks = new List<Task> { LoadPayablesAsync(), LoadPurchaseAlertsAsync(), LoadExpensesAsync(), LoadPurchasePeriodAsync(), LoadInventoryAsync(), LoadProjectsAsync(), LoadDocumentsAsync(), LoadDocumentedPurchasesAsync(), LoadGrossMarginAsync(), LoadOperatingResultAsync(), LoadRecentActivityAsync(), LoadFxAsync() };
        if (user.IsInRole("Administrator") || user.IsInRole("Accountant") || user.IsInRole("Sales"))
            tasks.AddRange([LoadAlertsAsync(), LoadSalesAsync(), LoadPeriodAsync(), LoadTrendAsync()]);
        await Task.WhenAll(tasks);
    }


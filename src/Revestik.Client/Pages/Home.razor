@code {
    // UX-DASH-02: solo clasificar cuando hay datos verificables; no inferir riesgo de un saldo bajo.
    private static string DashboardFinancialState(decimal? amount, bool requiresReview) =>
        amount is null ? string.Empty :
        amount < 0m ? "dashboard-state-danger" :
        amount == 0m || requiresReview ? "dashboard-state-warning" : "dashboard-state-normal";

    private string DashboardSalesState()
    {
        if (isLoadingPeriod || periodError is not null || periodSummary is null) return string.Empty;
        var current = PeriodCurrencies.FirstOrDefault(x => x.Currency.ToString() == selectedDashboardCurrency);
        return current is null ? string.Empty : current.SaleCount == 0 ? "dashboard-state-warning" : "dashboard-state-normal";
    }

    private string DashboardPayablesState()
    {
        if (isLoadingPayables || payablesError is not null) return string.Empty;
        var current = PayableCurrencies.FirstOrDefault(x => x.Currency.ToString() == selectedDashboardCurrency);
        return current is null ? string.Empty :
            current.OverdueCount > 0 ? "dashboard-state-danger" :
            current.PurchaseCount > 0 ? "dashboard-state-warning" : "dashboard-state-normal";
    }

    private string DashboardInventoryState()
    {
        if (isLoadingInventory || inventoryError is not null || inventorySummary is null || selectedDashboardCurrency != "CRC")
            return string.Empty;
        return inventorySummary.OutOfStockCount > 0 ? "dashboard-state-danger" :
            inventorySummary.LowStockCount > 0 ? "dashboard-state-warning" : "dashboard-state-normal";
    }

    private string DashboardProjectsState()
    {
        if (isLoadingProjects || projectsError is not null || projectsSummary is null || isLoadingAlerts || alertError is not null)
            return string.Empty;
        return alerts.Any(x => x.IsOverdue) ? "dashboard-state-danger" :
            alerts.Count > 0 ? "dashboard-state-warning" : "dashboard-state-normal";
    }

    private ExchangeRateResponse? fxRates;
    private bool fxLoading;
    private string? fxError;
    private string fxOperation = "ReceiveUsd";
    private decimal fxAmount = 100000m;
    private int fxProtection = 5;
    private bool FxValid => fxAmount >= 0 && fxAmount <= 100000000000m;
    private bool FxUsdInput => fxOperation is "ReceiveCrc" or "ExchangeUsd";
    private string FxInputCurrency => FxUsdInput ? "USD" : "CRC";
    private decimal FxOfficialRate => fxRates is null ? 0 :
        fxOperation is "ReceiveUsd" or "ExchangeUsd" ? fxRates.PurchaseRate : fxRates.SaleRate;
    private decimal FxAdjustedRate => fxOperation is "ReceiveUsd" or "ExchangeUsd"
        ? Math.Max(0.01m, FxOfficialRate - fxProtection)
        : FxOfficialRate + fxProtection;
    private decimal FxOfficialResult => fxRates is null ? 0 :
        FxUsdInput ? fxAmount * FxOfficialRate : fxAmount / FxOfficialRate;
    private decimal FxProtectedResult => fxRates is null ? 0 :
        FxUsdInput ? fxAmount * FxAdjustedRate : fxAmount / FxAdjustedRate;
    private string FxFormat(decimal value) =>
        (FxUsdInput ? "₡" : "$") + decimal.Round(value, 2, MidpointRounding.AwayFromZero).ToString("N2", RecentCulture);
    private string FxRecommendation => fxOperation switch
    {
        "ReceiveUsd" => "Si la venta está en colones y recibís dólares, usar una tasa de compra ligeramente menor ayuda a pedir suficientes USD para cubrir el precio original.",
        "ReceiveCrc" => "Si la venta está en dólares y recibís colones, usar una tasa de venta ligeramente mayor proporciona un margen para adquirir los USD equivalentes.",
        "ExchangeUsd" => "Si ya tenés dólares, este importe es una estimación conservadora de cuántos colones podrías obtener; el banco determina el monto real.",
        _ => "Si necesitás comprar dólares, presupuestar una tasa de venta ligeramente mayor ayuda a contemplar variaciones de mercado."
    };
    private async Task LoadFxAsync()
    {
        fxLoading = true;
        fxError = null;
        try
        {
            using var response = await Http.GetAsync("api/dashboard/exchange-rate");
            response.EnsureSuccessStatusCode();
            fxRates = await response.Content.ReadFromJsonAsync<ExchangeRateResponse>()
                ?? throw new InvalidOperationException("Respuesta vacía.");
            if (fxRates.PurchaseRate <= 0 || fxRates.SaleRate < fxRates.PurchaseRate)
                throw new InvalidOperationException("Cotizaciones inválidas.");
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException or InvalidOperationException)
        {
            fxRates = null;
            fxError = "No fue posible obtener la cotización BCCR. Revisá la configuración del servicio o intentá más tarde.";
        }
        finally { fxLoading = false; }
    }


                            <option value="7">₡7 por USD</option>
                        </select>
                        @if (!FxValid)
                        {
                            <p role="alert">Ingresá un importe entre 0 y 100.000.000.000.</p>
                        }
                        else
                        {
                            <div class="fx-result" aria-live="polite">
                                <span>Conversión BCCR sin ajuste</span>
                                <strong>@FxFormat(FxOfficialResult)</strong>

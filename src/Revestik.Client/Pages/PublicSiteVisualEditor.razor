@page "/settings/public-site/editor"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@attribute [Authorize(Roles = "Administrator")]
@inject NavigationManager Navigation

<PageTitle>Editor del sitio público | Revestik</PageTitle>
<p role="status">Abriendo el editor actual...</p>

@code {
    [SupplyParameterFromQuery(Name = "view")]
    public string? InitialView { get; set; }

    protected override void OnParametersSet()
    {
        var target = string.Equals(
            InitialView, "acabados", StringComparison.OrdinalIgnoreCase)
            ? "/es/acabados?edit=1"
            : "/es?edit=1";

        Navigation.NavigateTo(target, forceLoad: true, replace: true);
    }
}

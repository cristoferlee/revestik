@page "/settings"
@using Microsoft.AspNetCore.Authorization
@using Revestik.Client.Services.Products
@using Revestik.Shared.Products
@attribute [Authorize(Roles = "Administrator")]
@inject IInventoryCatalogApiService CatalogApi

<PageTitle>Configuración | Revestik</PageTitle>

<section class="settings-page">
    <header class="settings-header">
        <div>
            <h1>Configuración</h1>
            <p>Administrá los datos, accesos y parámetros operativos de Revestik.</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="status-message error-message" role="alert">
            @errorMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="status-message" role="status">
            @successMessage
        </div>
    }

    <section class="settings-group" aria-labelledby="settings-company-title">
        <div class="settings-group-title">
            <div>
                <h2 id="settings-company-title">Empresa y administración</h2>
                <p>Datos comerciales, documentos y control de acceso.</p>
            </div>
        </div>
        <div class="settings-shortcut-grid">
            <a class="settings-shortcut" href="settings/company">
                <span class="settings-shortcut-icon" aria-hidden="true">🏢</span>
                <span class="settings-shortcut-body"><strong>Mi empresa</strong><span>Información comercial, dirección y logotipo.</span></span>
                <span class="settings-shortcut-arrow" aria-hidden="true">&#8599;</span>
            </a>
            <a class="settings-shortcut" href="settings/document-pdf">
                <span class="settings-shortcut-icon" aria-hidden="true">📄</span>
                <span class="settings-shortcut-body"><strong>Documentos y PDF</strong><span>Presentación de cotizaciones y ventas.</span></span>
                <span class="settings-shortcut-arrow" aria-hidden="true">&#8599;</span>
            </a>
            <a class="settings-shortcut" href="settings/users">
                <span class="settings-shortcut-icon" aria-hidden="true">👥</span>
                <span class="settings-shortcut-body"><strong>Usuarios y permisos</strong><span>Colaboradores, roles y accesos.</span></span>
                <span class="settings-shortcut-arrow" aria-hidden="true">&#8599;</span>
            </a>
            <a class="settings-shortcut" href="settings/audit">
                <span class="settings-shortcut-icon" aria-hidden="true">🛡️</span>
                <span class="settings-shortcut-body"><strong>Seguridad y auditoría</strong><span>Historial de accesos y cambios administrativos.</span></span>
                <span class="settings-shortcut-arrow" aria-hidden="true">&#8599;</span>
            </a>
        </div>
    </section>

    <section class="settings-group" aria-labelledby="settings-operations-title">
        <div class="settings-group-title">
            <div>
                <h2 id="settings-operations-title">Operaciones y catálogos</h2>
                <p>Herramientas para administrar productos, compras y ventas.</p>
            </div>
        </div>
        <div class="settings-shortcut-grid">
            <a class="settings-shortcut" href="settings/suppliers">
                <span class="settings-shortcut-icon" aria-hidden="true">🚚</span>
                <span class="settings-shortcut-body"><strong>Proveedores</strong><span>Datos de proveedores para registrar compras.</span></span>
                <span class="settings-shortcut-arrow" aria-hidden="true">&#8599;</span>
            </a>
            <a class="settings-shortcut" href="settings/product-pricing">
                <span class="settings-shortcut-icon" aria-hidden="true">🏷️</span>
                <span class="settings-shortcut-body"><strong>Precio por unidad</strong><span>Cómo se aplica el precio de cada producto.</span></span>
                <span class="settings-shortcut-arrow" aria-hidden="true">&#8599;</span>
            </a>
        </div>
    </section>

    <section class="settings-group" aria-labelledby="settings-public-site-title">
        <div class="settings-group-title">
            <div>
                <h2 id="settings-public-site-title">Sitio web público</h2>
                <p>Administración independiente de los productos del inventario.</p>
            </div>
        </div>
        <div class="settings-shortcut-grid">
            <a class="settings-shortcut" href="settings/public-site">
                <span class="settings-shortcut-icon" aria-hidden="true">🌐</span>
                <span class="settings-shortcut-body"><strong>Contenido del sitio web</strong><span>Editor visual, categorías y contenido público.</span></span>
                <span class="settings-shortcut-arrow" aria-hidden="true">&#8599;</span>
            </a>
        </div>
    </section>

    <section class="settings-group settings-catalog-group" aria-labelledby="settings-catalog-title">
        <div class="settings-group-title">
            <div>
                <h2 id="settings-catalog-title">Catálogos de productos</h2>
                <p>Administrá las categorías, subcategorías y unidades compartidas.</p>
            </div>
        </div>
    <div class="settings-catalog-tabs" role="tablist" aria-label="Catálogos de productos">
        <button id="catalog-tab-categories" type="button" role="tab" aria-controls="catalog-panel-categories" aria-selected="@(catalogTab == "categories")" class="@(catalogTab == "categories" ? "selected" : "")" @onclick="ShowCategoriesTab">Categorías</button>
        <button id="catalog-tab-subcategories" type="button" role="tab" aria-controls="catalog-panel-subcategories" aria-selected="@(catalogTab == "subcategories")" class="@(catalogTab == "subcategories" ? "selected" : "")" @onclick="ShowSubcategoriesTab">Subcategorías</button>
        <button id="catalog-tab-units" type="button" role="tab" aria-controls="catalog-panel-units" aria-selected="@(catalogTab == "units")" class="@(catalogTab == "units" ? "selected" : "")" @onclick="ShowUnitsTab">Unidades de medida</button>
    </div>
    @if (catalogTab == "categories")
    {
    <div class="settings-card settings-tab-panel" role="tabpanel" id="catalog-panel-categories" aria-labelledby="catalog-tab-categories">
        <div class="settings-section-heading">
            <div>
                <h2>Categorías de producto</h2>
                <p>Estas categorías aparecen al crear o editar productos en Inventario.</p>
            </div>

        </div>
        <div class="settings-catalog-toolbar">
            <button type="button"
                    class="primary-button"
                    disabled="@isBusy"
                    @onclick="OpenNewCategory">
                Nueva categoría
            </button>
        </div>

        @if (categories.Count == 0)
        {
            <p class="empty-state">No hay categorías registradas.</p>
        }
        else
        {
            <div class="settings-list">
                @foreach (var category in categories.OrderBy(item => item.Name))
                {
                    <article class="settings-row">
                        <div>
                            <strong>@category.Name</strong>
                            <span class="settings-status">
                                @(category.IsActive ? "Activa" : "Inactiva")
                            </span>
                        </div>

                        <div class="settings-actions">
                            <button type="button"
                                    class="secondary-button"
                                    disabled="@isBusy"
                                    @onclick="() => OpenEditCategory(category)">
                                Editar
                            </button>

                            @if (category.IsActive)
                            {
                                <button type="button"
                                        class="secondary-button danger-button"
                                        disabled="@isBusy"
                                        @onclick="() => DeactivateCategoryAsync(category)">
                                    Desactivar
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        class="primary-button"
                                        disabled="@isBusy"
                                        @onclick="() => ReactivateCategoryAsync(category)">
                                    Reactivar
                                </button>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </div>
    }
    else if (catalogTab == "subcategories")
    {
    <div class="settings-card settings-tab-panel" role="tabpanel" id="catalog-panel-subcategories" aria-labelledby="catalog-tab-subcategories">
        <div class="settings-section-heading">
            <div><h2>Subcategorías de productos</h2>
                <p>Asigná cada subcategoría a una categoría principal. Se crean a medida que se necesitan.</p></div>
        </div>
        <div class="settings-catalog-toolbar">
            <button type="button" class="primary-button" disabled="@isBusy" @onclick="OpenNewSubcategory">Nueva subcategoría</button>
        </div>
        @if (subcategories.Count == 0)
        {
            <p class="empty-state">Todavía no hay subcategorías compartidas.</p>
        }
        else
        {
            <div class="settings-list">
                @foreach (var item in subcategories.OrderBy(x => x.CategoryName).ThenBy(x => x.Name))
                {
                    <article class="settings-row">
                        <div><strong>@item.Name</strong>
                            <span class="settings-symbol">@item.CategoryName</span>
                            <span class="settings-status">@(item.IsActive ? "Activa" : "Inactiva")</span>
                        </div>
                        <div class="settings-actions">
                            <button type="button" class="secondary-button" disabled="@isBusy" @onclick="() => OpenEditSubcategory(item)">Editar</button>
                            @if (item.IsActive)
                            {
                                <button type="button" class="secondary-button danger-button" disabled="@isBusy" @onclick="() => DeactivateSubcategoryAsync(item)">Desactivar</button>
                            }
                            else
                            {
                                <button type="button" class="primary-button" disabled="@isBusy" @onclick="() => ReactivateSubcategoryAsync(item)">Reactivar</button>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </div>
    }
    else
    {
    <div class="settings-card settings-tab-panel" role="tabpanel" id="catalog-panel-units" aria-labelledby="catalog-tab-units">
        <div class="settings-section-heading">
            <div>
                <h2>Unidades de medida</h2>
                <p>
                    Define cómo se cuenta físicamente un producto y si la unidad admite fracciones.
                </p>
            </div>

        </div>
        <div class="settings-catalog-toolbar">
            <button type="button"
                    class="primary-button"
                    disabled="@isBusy"
                    @onclick="OpenNewUnit">
                Nueva unidad
            </button>
        </div>

        @if (units.Count == 0)
        {
            <p class="empty-state">No hay unidades registradas.</p>
        }
        else
        {
            <div class="settings-list">
                @foreach (var unit in units.OrderBy(item => item.Name))
                {
                    <article class="settings-row">
                        <div>
                            <strong>@unit.Name</strong>
                            <span class="settings-symbol">@unit.Symbol</span>
                            <span class="settings-status">
                                @(unit.RequiresWholeQuantity
                                    ? "Solo enteros"
                                    : "Permite decimales")
                            </span>
                            <span class="settings-status">
                                @(unit.IsActive ? "Activa" : "Inactiva")
                            </span>
                        </div>

                        <div class="settings-actions">
                            <button type="button"
                                    class="secondary-button"
                                    disabled="@isBusy"
                                    @onclick="() => OpenEditUnit(unit)">
                                Editar
                            </button>

                            @if (unit.IsActive)
                            {
                                <button type="button"
                                        class="secondary-button danger-button"
                                        disabled="@isBusy"
                                        @onclick="() => DeactivateUnitAsync(unit)">
                                    Desactivar
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        class="primary-button"
                                        disabled="@isBusy"
                                        @onclick="() => ReactivateUnitAsync(unit)">
                                    Reactivar
                                </button>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </div>
    }

    </section>

    @if (isCategoryFormOpen)
    {
        <div class="settings-modal-backdrop" @onclick="CloseForms">
            <section class="settings-modal"
                     role="dialog"
                     aria-modal="true"
                     @onclick:stopPropagation>
                <div class="settings-section-heading">
                    <div>
                        <h2>@(editingCategoryId.HasValue ? "Editar categoría" : "Nueva categoría")</h2>
                    </div>
                    <button type="button"
                            class="secondary-button"
                            disabled="@isBusy"
                            @onclick="CloseForms">
                        Cerrar
                    </button>
                </div>

                <EditForm Model="categoryRequest"
                          OnValidSubmit="SaveCategoryAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="form-group">
                        <label>Nombre</label>
                        <InputText @bind-Value="categoryRequest.Name"
                                   maxlength="100" />
                        <ValidationMessage For="@(() => categoryRequest.Name)" />
                    </div>

                    <div class="form-actions">
                        <button type="button"
                                class="secondary-button"
                                disabled="@isBusy"
                                @onclick="CloseForms">
                            Cancelar
                        </button>
                        <button type="submit"
                                class="primary-button"
                                disabled="@isBusy">
                            @(isSaving ? "Guardando..." : "Guardar")
                        </button>
                    </div>
                </EditForm>
            </section>
        </div>
    }

    @if (isSubcategoryFormOpen)
    {
        <div class="settings-modal-backdrop" @onclick="CloseForms">
            <section class="settings-modal" role="dialog" aria-modal="true" aria-labelledby="settings-subcategory-modal-title" @onclick:stopPropagation>
                <div class="settings-section-heading"><div>
                    <h2 id="settings-subcategory-modal-title">@(editingSubcategoryId.HasValue ? "Editar subcategoría" : "Nueva subcategoría")</h2>
                </div></div>
                <EditForm Model="subcategoryRequest" OnValidSubmit="SaveSubcategoryAsync">
                    <DataAnnotationsValidator />
                    <div class="form-grid">
                        <div class="form-field">
                            <label for="subcategory-category">Categoría principal</label>
                            <InputSelect id="subcategory-category" @bind-Value="subcategoryRequest.CategoryId">
                                <option value="0">Seleccionar categoría</option>
                                @foreach (var category in categories.Where(x => x.IsActive || x.Id == subcategoryRequest.CategoryId))
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => subcategoryRequest.CategoryId)" />
                        </div>
                        <div class="form-field">
                            <label for="subcategory-name">Nombre</label>
                            <InputText id="subcategory-name" @bind-Value="subcategoryRequest.Name" maxlength="100" />
                            <ValidationMessage For="@(() => subcategoryRequest.Name)" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button type="button" class="secondary-button" disabled="@isBusy" @onclick="CloseForms">Cancelar</button>
                        <button type="submit" class="primary-button" disabled="@isBusy">@(isSaving ? "Guardando..." : "Guardar")</button>
                    </div>
                </EditForm>
            </section>
        </div>
    }

    @if (isUnitFormOpen)
    {
        <div class="settings-modal-backdrop" @onclick="CloseForms">
            <section class="settings-modal"
                     role="dialog"
                     aria-modal="true"
                     @onclick:stopPropagation>
                <div class="settings-section-heading">
                    <div>
                        <h2>@(editingUnitId.HasValue ? "Editar unidad" : "Nueva unidad")</h2>
                    </div>
                    <button type="button"
                            class="secondary-button"
                            disabled="@isBusy"
                            @onclick="CloseForms">
                        Cerrar
                    </button>
                </div>

                <EditForm Model="unitRequest"
                          OnValidSubmit="SaveUnitAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="form-grid">
                        <div class="form-group">
                            <label>Nombre</label>
                            <InputText @bind-Value="unitRequest.Name"
                                       maxlength="100" />
                            <ValidationMessage For="@(() => unitRequest.Name)" />
                        </div>

                        <div class="form-group">
                            <label>Símbolo</label>
                            <InputText @bind-Value="unitRequest.Symbol"
                                       maxlength="20"
                                       placeholder="Ejemplo: caja, m², und" />
                            <ValidationMessage For="@(() => unitRequest.Symbol)" />
                        </div>

                        <div class="form-group form-wide">
                            <label>
                                <InputCheckbox @bind-Value="unitRequest.RequiresWholeQuantity" />
                                Esta unidad solo admite cantidades enteras
                            </label>
                            <small class="field-guidance">
                                Actívalo para unidades indivisibles como caja, unidad o pieza.
                                Déjalo desactivado para m², kg, litros, galones y otras medidas fraccionables.
                            </small>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="button"
                                class="secondary-button"
                                disabled="@isBusy"
                                @onclick="CloseForms">
                            Cancelar
                        </button>
                        <button type="submit"
                                class="primary-button"
                                disabled="@isBusy">
                            @(isSaving ? "Guardando..." : "Guardar")
                        </button>
                    </div>
                </EditForm>
            </section>
        </div>
    }
</section>

@code {
    private IReadOnlyList<ProductCategoryResponse> categories = [];
    private IReadOnlyList<UnitOfMeasureResponse> units = [];
    private IReadOnlyList<ProductSubcategoryResponse> subcategories = [];
    private string catalogTab = "categories";

    private ProductCategoryUpsertRequest categoryRequest = new();
    private UnitOfMeasureUpsertRequest unitRequest = new();
    private ProductSubcategoryUpsertRequest subcategoryRequest = new();
    private string subcategoryVersion = string.Empty;

    private int? editingCategoryId;
    private int? editingUnitId;
    private int? editingSubcategoryId;
    private bool isCategoryFormOpen;
    private bool isUnitFormOpen;
    private bool isSubcategoryFormOpen;
    private bool isLoading;
    private bool isSaving;

    private string? errorMessage;
    private string? successMessage;

    private bool isBusy => isLoading || isSaving;

    protected override async Task OnInitializedAsync()
    {
        await LoadCatalogsAsync();
    }

    private async Task LoadCatalogsAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            categories = await CatalogApi.GetCategoriesAsync(includeInactive: true);
            units = await CatalogApi.GetUnitsAsync(includeInactive: true);
            subcategories = await CatalogApi.GetSubcategoriesAsync(includeInactive: true);

        }
        catch (HttpRequestException exception)
        {
            errorMessage = $"No se pudo cargar la configuración. {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenNewCategory()
    {
        ClearMessages();
        editingCategoryId = null;
        categoryRequest = new ProductCategoryUpsertRequest
        {
            IsActive = true
        };
        isCategoryFormOpen = true;
    }

    private void OpenEditCategory(ProductCategoryResponse category)
    {
        ClearMessages();
        editingCategoryId = category.Id;
        categoryRequest = new ProductCategoryUpsertRequest
        {
            Name = category.Name,
            IsActive = category.IsActive
        };
        isCategoryFormOpen = true;
    }

    private async Task SaveCategoryAsync()
    {
        isSaving = true;
        ClearMessages();

        try
        {
            if (editingCategoryId.HasValue)
            {
                var updated = await CatalogApi.UpdateCategoryAsync(
                    editingCategoryId.Value,
                    categoryRequest);

                if (updated is null)
                {
                    errorMessage = "La categoría ya no existe.";
                    return;
                }

                successMessage = $"Categoría {updated.Name} actualizada.";
            }
            else
            {
                var created = await CatalogApi.CreateCategoryAsync(categoryRequest);
                successMessage = $"Categoría {created.Name} creada.";
            }

            isCategoryFormOpen = false;
            await LoadCatalogsAsync();
        }
        catch (HttpRequestException exception)
        {
            errorMessage = $"No se pudo guardar la categoría. {exception.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeactivateCategoryAsync(ProductCategoryResponse category)
    {
        isSaving = true;
        ClearMessages();

        try
        {
            if (!await CatalogApi.DeactivateCategoryAsync(category.Id))
            {
                errorMessage = "La categoría ya no existe.";
                return;
            }

            successMessage = $"Categoría {category.Name} desactivada.";
            await LoadCatalogsAsync();
        }
        catch (HttpRequestException exception)
        {
            errorMessage = $"No se pudo desactivar la categoría. {exception.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ReactivateCategoryAsync(ProductCategoryResponse category)
    {
        isSaving = true;
        ClearMessages();

        try
        {
            var updated = await CatalogApi.UpdateCategoryAsync(
                category.Id,
                new ProductCategoryUpsertRequest
                {
                    Name = category.Name,
                    IsActive = true
                });

            if (updated is null)
            {
                errorMessage = "La categoría ya no existe.";
                return;
            }

            successMessage = $"Categoría {updated.Name} reactivada.";
            await LoadCatalogsAsync();
        }
        catch (HttpRequestException exception)
        {
            errorMessage = $"No se pudo reactivar la categoría. {exception.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ShowCategoriesTab() => SelectCatalogTab("categories");
    private void ShowSubcategoriesTab() => SelectCatalogTab("subcategories");
    private void ShowUnitsTab() => SelectCatalogTab("units");

    private void SelectCatalogTab(string tab)
    {
        catalogTab = tab;
        CloseForms();
        ClearMessages();
    }

    private void OpenNewSubcategory()
    {
        ClearMessages();
        editingSubcategoryId = null;
        subcategoryVersion = string.Empty;
        subcategoryRequest = new ProductSubcategoryUpsertRequest
        {
            CategoryId = categories.FirstOrDefault(x => x.IsActive)?.Id ?? 0
        };
        isSubcategoryFormOpen = true;
    }

    private void OpenEditSubcategory(ProductSubcategoryResponse item)
    {
        ClearMessages();
        editingSubcategoryId = item.Id;
        subcategoryVersion = item.Version;
        subcategoryRequest = new ProductSubcategoryUpsertRequest
        {
            CategoryId = item.CategoryId, Name = item.Name, IsActive = item.IsActive
        };
        isSubcategoryFormOpen = true;
    }

    private async Task SaveSubcategoryAsync()
    {
        isSaving = true;
        ClearMessages();
        try
        {
            if (editingSubcategoryId.HasValue)
            {
                var item = await CatalogApi.UpdateSubcategoryAsync(editingSubcategoryId.Value,
                    new ProductSubcategoryWriteRequest
                    {
                        CategoryId = subcategoryRequest.CategoryId,
                        Name = subcategoryRequest.Name,
                        IsActive = subcategoryRequest.IsActive,
                        Version = subcategoryVersion
                    });
                if (item is null) { errorMessage = "La subcategoría ya no existe."; return; }
                successMessage = $"Subcategoría {item.Name} actualizada.";
            }
            else
            {
                var item = await CatalogApi.CreateSubcategoryAsync(subcategoryRequest);
                successMessage = $"Subcategoría {item.Name} creada.";
            }
            isSubcategoryFormOpen = false;
            await LoadCatalogsAsync();
        }
        catch (HttpRequestException e) { errorMessage = $"No se pudo guardar la subcategoría. {e.Message}"; }
        finally { isSaving = false; }
    }

    private async Task DeactivateSubcategoryAsync(ProductSubcategoryResponse item)
    {
        isSaving = true;
        ClearMessages();
        try
        {
            if (!await CatalogApi.DeactivateSubcategoryAsync(item.Id, item.Version))
            { errorMessage = "La subcategoría ya no existe."; return; }
            successMessage = $"Subcategoría {item.Name} desactivada.";
            await LoadCatalogsAsync();
        }
        catch (HttpRequestException e) { errorMessage = e.Message; }
        finally { isSaving = false; }
    }

    private async Task ReactivateSubcategoryAsync(ProductSubcategoryResponse item)
    {
        isSaving = true;
        ClearMessages();
        try
        {
            var updated = await CatalogApi.UpdateSubcategoryAsync(item.Id,
                new ProductSubcategoryWriteRequest
                {
                    CategoryId = item.CategoryId, Name = item.Name,
                    IsActive = true, Version = item.Version
                });
            if (updated is null) { errorMessage = "La subcategoría ya no existe."; return; }
            successMessage = $"Subcategoría {item.Name} reactivada.";
            await LoadCatalogsAsync();
        }
        catch (HttpRequestException e) { errorMessage = e.Message; }
        finally { isSaving = false; }
    }

    private void OpenNewUnit()
    {
        ClearMessages();
        editingUnitId = null;
        unitRequest = new UnitOfMeasureUpsertRequest
        {
            IsActive = true
        };
        isUnitFormOpen = true;
    }

    private void OpenEditUnit(UnitOfMeasureResponse unit)
    {
        ClearMessages();
        editingUnitId = unit.Id;
        unitRequest = new UnitOfMeasureUpsertRequest
        {
            Name = unit.Name,
            Symbol = unit.Symbol,
            RequiresWholeQuantity = unit.RequiresWholeQuantity,
            IsActive = unit.IsActive
        };
        isUnitFormOpen = true;
    }

    private async Task SaveUnitAsync()
    {
        isSaving = true;
        ClearMessages();

        try
        {
            if (editingUnitId.HasValue)
            {
                var updated = await CatalogApi.UpdateUnitAsync(
                    editingUnitId.Value,
                    unitRequest);

                if (updated is null)
                {
                    errorMessage = "La unidad ya no existe.";
                    return;
                }

                successMessage = $"Unidad {updated.Name} actualizada.";
            }
            else
            {
                var created = await CatalogApi.CreateUnitAsync(unitRequest);
                successMessage = $"Unidad {created.Name} creada.";
            }

            isUnitFormOpen = false;
            await LoadCatalogsAsync();
        }
        catch (HttpRequestException exception)
        {
            errorMessage = $"No se pudo guardar la unidad. {exception.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeactivateUnitAsync(UnitOfMeasureResponse unit)
    {
        isSaving = true;
        ClearMessages();

        try
        {
            if (!await CatalogApi.DeactivateUnitAsync(unit.Id))
            {
                errorMessage = "La unidad ya no existe.";
                return;
            }

            successMessage = $"Unidad {unit.Name} desactivada.";
            await LoadCatalogsAsync();
        }
        catch (HttpRequestException exception)
        {
            errorMessage = $"No se pudo desactivar la unidad. {exception.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ReactivateUnitAsync(UnitOfMeasureResponse unit)
    {
        isSaving = true;
        ClearMessages();

        try
        {
            var updated = await CatalogApi.UpdateUnitAsync(
                unit.Id,
                new UnitOfMeasureUpsertRequest
                {
                    Name = unit.Name,
                    Symbol = unit.Symbol,
                    RequiresWholeQuantity = unit.RequiresWholeQuantity,
                    IsActive = true
                });

            if (updated is null)
            {
                errorMessage = "La unidad ya no existe.";
                return;
            }

            successMessage = $"Unidad {updated.Name} reactivada.";
            await LoadCatalogsAsync();
        }
        catch (HttpRequestException exception)
        {
            errorMessage = $"No se pudo reactivar la unidad. {exception.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void CloseForms()
    {
        if (isSaving)
        {
            return;
        }

        isCategoryFormOpen = false;
        isUnitFormOpen = false;
        isSubcategoryFormOpen = false;
        editingSubcategoryId = null;
        editingCategoryId = null;
        editingUnitId = null;
    }

    private void ClearMessages()
    {
        errorMessage = null;
        successMessage = null;
    }
}
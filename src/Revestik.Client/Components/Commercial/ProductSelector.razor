@using Revestik.Shared.Products

<section class="product-search-panel">
    <div class="page-header">
        <div>
            <h4>Buscar en inventario</h4>
            <p>Selecciona un producto o filtra por nombre, descripción o CABYS.</p>
        </div>

        @if (OnClose.HasDelegate)
        {
            <button type="button" class="secondary-button" @onclick="CloseAsync">Cerrar</button>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="status-message error-message" role="alert">@errorMessage</div>
    }

    <form class="search-form" @onsubmit="SearchProductsAsync" @onsubmit:preventDefault>
        <input type="search"
               maxlength="150"
               placeholder="Nombre, descripción o CABYS"
               aria-label="Buscar producto por nombre, descripción o CABYS"
               @bind="productSearchTerm" />

        <button type="submit" class="primary-button" disabled="@isSearchingProducts">
            @(isSearchingProducts ? "Buscando..." : "Buscar")
        </button>

        @if (!string.IsNullOrWhiteSpace(productSearchTerm))
        {
            <button type="button" class="secondary-button" disabled="@isSearchingProducts" @onclick="ClearSearchAsync">
                Limpiar
            </button>
        }
    </form>

    @if (isSearchingProducts)
    {
        <p class="empty-state">Cargando productos...</p>
    }
    else if (hasSearchedProducts && productSearchResults.Count == 0)
    {
        <p class="empty-state">No se encontraron productos.</p>
    }
    else if (productSearchResults.Count > 0)
    {
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>CABYS</th>
                        <th>Presentación</th>
                        <th>Precio</th>
                        <th>IVA</th>
                        <th>Stock</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in productSearchResults)
                    {
                        <tr>
                            <td data-label="Producto">
                                <strong>@product.Name</strong>
                                @if (!string.IsNullOrWhiteSpace(product.Description))
                                {
                                    <br />
                                    <small>@product.Description</small>
                                }
                            </td>
                            <td data-label="CABYS">@product.CabysCode</td>
                            <td data-label="Presentación">
                                1 @product.InventoryUnitSymbol =
                                @product.CommercialUnitsPerInventoryUnit.ToString("N4")
                                @product.CommercialUnitSymbol
                            </td>
                            <td data-label="Precio">
                                ₡@product.SalePrice.ToString("N2") / @product.CommercialUnitSymbol
                            </td>
                            <td data-label="IVA">@product.TaxRate.ToString("N0")%</td>
                            <td data-label="Stock">
                                @product.AvailableStock.ToString("N2") @product.InventoryUnitSymbol
                            </td>
                            <td data-label="Acción">
                                <button type="button"
                                        class="secondary-button"
                                        @onclick="() => SelectProductAsync(product)">
                                    Seleccionar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
@implements IDisposable
@inject NavigationManager Navigation

<nav class="main-navigation" aria-label="Navegación principal">
    <button class="navigation-toggle"
            type="button"
            aria-expanded="@isNavigationOpen"
            aria-controls="primary-navigation"
            @onclick="ToggleNavigation">
        <span>Menú principal</span>
        <span aria-hidden="true">☰</span>
    </button>

    <div id="primary-navigation" class="@NavigationCssClass">
        <NavLink class="navigation-link" href="/" Match="NavLinkMatch.All" @onclick="CloseNavigation">
            <span class="nav-icon" aria-hidden="true">⌂</span><span>Dashboard</span>
        </NavLink>

        <NavLink class="navigation-link" href="/customers" @onclick="CloseNavigation">
            <span class="nav-icon" aria-hidden="true">◎</span><span>Clientes</span>
        </NavLink>

        <NavLink class="navigation-link" href="/quotes" @onclick="CloseNavigation">
            <span class="nav-icon" aria-hidden="true">▤</span><span>Cotizaciones</span>
        </NavLink>

        <NavLink class="navigation-link" href="/sales" @onclick="CloseNavigation">
            <span class="nav-icon" aria-hidden="true">↗</span><span>Ventas</span>
        </NavLink>

        <NavLink class="navigation-link"
                 href="/inventory"
                 Match="NavLinkMatch.All"
                 @onclick="CloseNavigation">
            <span class="nav-icon" aria-hidden="true">◇</span><span>Inventario</span>
        </NavLink>

        <NavLink class="navigation-link" href="/inventory/cost-layers" @onclick="CloseNavigation">
            <span class="nav-icon" aria-hidden="true">≋</span><span>Lotes de costo</span>
        </NavLink>

        <div class="navigation-group @(IsPurchasesSection ? "navigation-group-current" : null)">
            <button type="button"
                    class="navigation-link navigation-group-toggle"
                    aria-expanded="@isPurchasesOpen"
                    aria-controls="purchases-navigation"
                    @onclick="TogglePurchasesGroup">
                <span class="nav-icon" aria-hidden="true">⇣</span>
                <span class="navigation-group-label">Compras</span>
                <span class="navigation-chevron @(isPurchasesOpen ? "navigation-chevron-open" : null)" aria-hidden="true">⌄</span>
            </button>

            <div id="purchases-navigation" class="@PurchasesSubmenuCssClass">
                <NavLink class="navigation-sublink"
                         href="/purchases"
                         Match="NavLinkMatch.All"
                         @onclick="CloseNavigation">
                    Nueva compra
                </NavLink>

                <NavLink class="navigation-sublink"
                         href="/purchases/received-documents"
                         @onclick="CloseNavigation">
                    Documentos recibidos
                </NavLink>

                <NavLink class="navigation-sublink"
                         href="/purchases/history"
                         @onclick="CloseNavigation">
                    Historial y cuentas por pagar
                </NavLink>

                <NavLink class="navigation-sublink"
                         href="/cabys"
                         @onclick="CloseNavigation">
                    CAByS
                </NavLink>
            </div>
        </div>

        <AuthorizeView Roles="Administrator,Accountant">
            <NavLink class="navigation-link" href="/expenses" @onclick="CloseNavigation">
                <span class="nav-icon" aria-hidden="true">₡</span><span>Gastos</span>
            </NavLink>
        </AuthorizeView>

        <AuthorizeView Roles="Administrator">
            <div class="navigation-divider"></div>

            <NavLink class="navigation-link" href="/settings" @onclick="CloseNavigation">
                <span class="nav-icon" aria-hidden="true">⚙</span><span>Configuración</span>
            </NavLink>
        </AuthorizeView>
    </div>
</nav>

@code {
    private bool isNavigationOpen;
    private bool isPurchasesOpen;

    private string NavigationCssClass =>
        isNavigationOpen
            ? "navigation-links navigation-links-open"
            : "navigation-links";

    private string PurchasesSubmenuCssClass =>
        isPurchasesOpen
            ? "navigation-submenu navigation-submenu-open"
            : "navigation-submenu";

    private bool IsPurchasesSection => IsPurchasesUri(Navigation.Uri);

    protected override void OnInitialized()
    {
        isPurchasesOpen = IsPurchasesSection;
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private void ToggleNavigation()
    {
        isNavigationOpen = !isNavigationOpen;
    }

    private void TogglePurchasesGroup()
    {
        isPurchasesOpen = !isPurchasesOpen;
    }

    private void CloseNavigation()
    {
        isNavigationOpen = false;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (IsPurchasesUri(args.Location))
        {
            isPurchasesOpen = true;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private bool IsPurchasesUri(string uri)
    {
        var relative = Navigation.ToBaseRelativePath(uri);

        return relative.Equals("purchases", StringComparison.OrdinalIgnoreCase) ||
               relative.StartsWith("purchases/", StringComparison.OrdinalIgnoreCase) ||
               relative.Equals("cabys", StringComparison.OrdinalIgnoreCase) ||
               relative.StartsWith("cabys?", StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}

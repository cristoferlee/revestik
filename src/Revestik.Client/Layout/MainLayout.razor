@inherits LayoutComponentBase

<div class="app-shell">
    <AuthorizeView>
        <Authorized>
            <header class="app-topbar">
                <NavLink class="app-brand"
                         href="/"
                         Match="NavLinkMatch.All"
                         aria-label="Ir al Dashboard de Revestik">
                    <img class="app-logo"
                         src="/assets/logo/revestik-sidebar-logo.png"
                         alt="Revestik" />
                </NavLink>

                <UserSessionMenu />
            </header>

            <aside class="app-sidebar">
                <NavMenu />
            </aside>

            <div class="app-workspace">
                <main class="app-content">
                    @Body
                </main>

                <footer class="app-footer">
                    <p>© @CurrentYear Revestik</p>
                </footer>
            </div>
        </Authorized>

        <NotAuthorized>
            <div class="auth-shell">
                <header class="auth-header">
                    <NavLink href="/" aria-label="Ir al inicio">
                        <img class="auth-logo"
                             src="/assets/logo/revestik-sidebar-logo.png"
                             alt="Revestik" />
                    </NavLink>
                </header>

                <main class="auth-content">
                    @Body
                </main>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private int CurrentYear => DateTime.UtcNow.Year;
}

@inject NavigationManager NavigationManager

@code {
    protected override void OnInitialized()
    {
        var basePath = new Uri(NavigationManager.BaseUri)
            .AbsolutePath.TrimEnd('/');

        var relativePath = NavigationManager
            .ToBaseRelativePath(NavigationManager.Uri);

        var returnPath = string.IsNullOrWhiteSpace(relativePath)
            ? $"{basePath}/"
            : $"{basePath}/{relativePath}";

        var loginUrl =
            $"{basePath}/login?returnPath={Uri.EscapeDataString(returnPath)}";

        NavigationManager.NavigateTo(loginUrl);
    }
}
@page "/es/soluciones"
@page "/en/solutions"
@page "/de/loesungen"
@using Revestik.Public.Components.Shared
@using Revestik.Public.Services
@using Revestik.Shared.PublicSite
@inject NavigationManager Navigation
@inject PublicCatalogReader Catalog
@inject ILogger<Solutions> Logger
@{
    var lang = Locale.FromUri(Navigation.Uri);
    var seo = PublicSeo.Get(lang, 3);
    var t = Locale.Get(lang);
}
<PageTitle>@seo.Title</PageTitle>
<HeadContent>
    <meta name="description" content="@seo.Description" />
    <meta name="robots" content="noindex,follow" />
</HeadContent>
<main id="main" class="editorial-page editorial-page--solutions">
    <EditorialHero Variant="solutions" ImageSrc="@HeroImageSrc"
                   Eyebrow="@(Value("hero", lang, "eyebrow"))"
                   Heading="@(Value("hero", lang, "title"))"
                   Introduction="@(Value("hero", lang, "description"))"
                   PrimaryHref="@SiteLinks.Path(lang, 2)" PrimaryLabel="@t.Nav[2]"
                   SecondaryHref="@SiteLinks.Path(lang, 5)" SecondaryLabel="@t.Nav[5]" />

    <div class="editorial-content">
        <section class="editorial-intro" aria-labelledby="solutions-intro-title">
            <div>
                <p class="editorial-kicker">01 / @Value("approach", lang, "eyebrow")</p>
                <h2 id="solutions-intro-title">@Value("approach", lang, "title")</h2>
            </div>
            <p>@Value("approach", lang, "description")</p>
        </section>

        <section class="editorial-offerings" aria-labelledby="solutions-options-title">
            <div class="editorial-section-heading">
                <p class="editorial-kicker">02 / @Value("applications", lang, "eyebrow")</p>
                <h2 id="solutions-options-title">@Value("applications", lang, "title")</h2>
            </div>
            <div class="editorial-rows">
                <article class="editorial-row">
                    <span class="editorial-row-number" aria-hidden="true">01</span>
                    <div>
                        <h3>@Value("interior-flooring", lang, "title")</h3>
                        <p>@Value("interior-flooring", lang, "description")</p>
                    </div>
                </article>
                <article class="editorial-row">
                    <span class="editorial-row-number" aria-hidden="true">02</span>
                    <div>
                        <h3>@Value("exterior-flooring", lang, "title")</h3>
                        <p>@Value("exterior-flooring", lang, "description")</p>
                    </div>
                </article>
                <article class="editorial-row">
                    <span class="editorial-row-number" aria-hidden="true">03</span>
                    <div>
                        <h3>@Value("walls-facades", lang, "title")</h3>
                        <p>@Value("walls-facades", lang, "description")</p>
                    </div>
                </article>
            </div>
        </section>

        <aside class="editorial-cta" aria-labelledby="solutions-cta-title">
            <div>
                <p class="editorial-kicker">@Value("cta", lang, "eyebrow")</p>
                <h2 id="solutions-cta-title">@Value("cta", lang, "title")</h2>
                <p>@Value("cta", lang, "description")</p>
            </div>
            <div class="editorial-cta-actions">
                <a href="@SiteLinks.Path(lang, 2)">@t.Nav[2] <span aria-hidden="true">&#8594;</span></a>
                <a class="editorial-cta-secondary" href="@SiteLinks.Path(lang, 5)">@t.Nav[5]</a>
            </div>
        </aside>
    </div>
</main>

@code {
    private readonly Dictionary<string, SolutionsSectionDto> _saved = new(StringComparer.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            foreach (var section in await Catalog.SolutionsSections())
            {
                if (SolutionsSectionDefaults.IsKnown(section.Key))
                    _saved[section.Key] = section;
            }
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "Solutions editorial content unavailable; rendering approved defaults.");
        }
        catch (TaskCanceledException ex)
        {
            Logger.LogWarning(ex, "Solutions editorial content timed out; rendering approved defaults.");
        }
    }

    // Versioned URL prevents a previously cached photograph surviving a concurrent edit.
    private string? HeroImageSrc => _saved.TryGetValue("hero", out var hero) && hero.HasImage
        ? $"/api/public/site/solutions-sections/hero/media?v={Uri.EscapeDataString(hero.Version)}"
        : null;

    private string Value(string key, string language, string field) =>
        _saved.TryGetValue(key, out var section)
            ? section.Value(language, field)
            : SolutionsSectionDefaults.Create(key).Value(language, field);
}

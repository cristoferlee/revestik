@page "/es/proyectos"
@page "/en/projects"
@page "/de/projekte"
@inject NavigationManager Navigation
@{
    var lang = Locale.FromUri(Navigation.Uri);
    var seo = PublicSeo.Get(lang, 1);
}
<PageTitle>@seo.Title</PageTitle>
<HeadContent>
    <meta name="description" content="@Description(lang)" />
    <meta name="robots" content="noindex,follow" />
</HeadContent>
<main id="main" class="subpage projects-index">
    <div class="subpage-inner">
        <header class="projects-index-header">
            <p class="eyebrow">REVESTIK &middot; COSTA RICA</p>
            <h1>@seo.Heading</h1>
            <p class="projects-index-intro">@Introduction(lang)</p>
        </header>
        <ProjectGallery Language="@lang" Page="@(Page ?? 1)" />
    </div>
</main>

@code {
    [SupplyParameterFromQuery(Name = "page")] public int? Page { get; set; }

    private static string Introduction(string language) => language switch
    {
        "en" => "Explore selected published projects and discover the materials used in their spaces.",
        "de" => "Entdecken Sie ausgewählte veröffentlichte Projekte und die verwendeten Materialien.",
        _ => "Explorá nuestros proyectos publicados y conocé los materiales utilizados en sus espacios."
    };

    private static string Description(string language) => language switch
    {
        "en" => "Explore published REVESTIK projects, photographs and selected architectural finishes in Costa Rica.",
        "de" => "Entdecken Sie veröffentlichte REVESTIK-Projekte, Fotos und ausgewählte Oberflächen in Costa Rica.",
        _ => "Conocé proyectos publicados, fotografías y acabados seleccionados de REVESTIK en Costa Rica."
    };
}

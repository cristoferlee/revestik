@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using Revestik.Public.Services
@using Revestik.Shared.PublicSite
@inject AuthenticationStateProvider AuthenticationState
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (!string.IsNullOrWhiteSpace(error) && product is null && !confirmDelete)
{
    <div class="revestik-editor-error" role="alert">@error</div>
}
@if (product is not null || confirmDelete || confirmPublication)
{
    <div class="revestik-editor-backdrop">
        <section class="revestik-editor-dialog revestik-product-dialog" role="dialog" aria-modal="true" aria-labelledby="revestik-product-dialog-heading">
            <header class="revestik-editor-dialog-header">
                <div><p>REVESTIK · Acabados</p><h2 id="revestik-product-dialog-heading">@(confirmDelete ? "Eliminar producto" : confirmPublication ? "Cambiar publicación" : product?.Id > 0 ? "Editar producto" : "Agregar producto")</h2></div>
                <button type="button" disabled="@busy" aria-label="Cerrar" @onclick="CancelAsync">×</button>
            </header>
            @if (!string.IsNullOrWhiteSpace(error))
            {
                <p role="alert" class="revestik-editor-error">@error</p>
            }
            @if (confirmDelete)
            {
                <p>¿Eliminar definitivamente «@deleteName»? Esta operación no se puede deshacer.</p>
                <div class="revestik-editor-actions">
                    <button type="button" disabled="@busy" @onclick="CancelAsync">Cancelar</button>
                    <button type="button" disabled="@busy" class="revestik-editor-danger" @onclick="DeleteConfirmedAsync">Eliminar producto</button>
                </div>
            }
            else if (confirmPublication && publicationProduct is not null)
            {
                <p>¿Confirmás que querés @(publicationProduct.IsPublished ? "despublicar" : "publicar") «@publicationName»?</p>
                <div class="revestik-editor-actions">
                    <button type="button" disabled="@busy" @onclick="CancelAsync">Cancelar</button>
                    <button type="button" class="revestik-editor-primary" disabled="@busy" @onclick="ChangePublicationConfirmedAsync">Confirmar</button>
                </div>
            }
            else if (product is { } current)
            {
                @if (confirmSave)
                {
                    <p>¿Confirmás el guardado? @(current.Id == 0 ? "El producto se publicará inmediatamente." : current.IsPublished ? "Los cambios serán visibles en el catálogo público." : "El producto permanecerá sin publicar.")</p>
                    <div class="revestik-editor-actions">
                        <button type="button" disabled="@busy" @onclick="() => confirmSave = false">Volver</button>
                        <button type="button" disabled="@busy" class="revestik-editor-primary" @onclick="SaveConfirmedAsync">Confirmar y guardar</button>
                    </div>
                }
                else
                {
                    <div class="revestik-editor-fields">
                        <label>Nombre en español *<input maxlength="200" @bind="Es.Name" /></label>
                        <label>Descripción en español *<textarea rows="4" maxlength="4000" @bind="Es.Description"></textarea></label>
                        <label>Marca (opcional)<input maxlength="150" @bind="current.Brand" /></label>
                        <label>Categoría *
                            <select value="@selectedCategoryId" @onchange="ChangeCategory">
                                <option value="0">Seleccioná una categoría</option>
                                @foreach (var category in categories)
                                {
                                    <option value="@category.Id">@category.NameEs</option>
                                }
                            </select>
                        </label>
                        @if (selectedCategoryId != 0)
                        {
                            <fieldset class="revestik-editor-choices"><legend>Subcategorías *</legend>
                                @if (!subcategories.Any(x => x.CategoryId == selectedCategoryId))
                                {
                                    <p>Creá primero una subcategoría desde Configuración → Catálogos de productos.</p>
                                }
                                @foreach (var item in subcategories.Where(x => x.CategoryId == selectedCategoryId))
                                {
                                    var subId = item.Id;
                                    <label class="revestik-editor-checkbox"><input type="checkbox" checked="@current.SubcategoryIds.Contains(subId)" @onchange="e => ToggleSubcategory(subId, e.Value is true)" /> @item.NameEs</label>
                                }
                            </fieldset>
                        }
                        <div class="revestik-editor-split">
                            <label>Precio (opcional)<input type="number" min="0" step="0.01" @bind="current.Price" /></label>
                            <label>Moneda<select @bind="current.Currency"><option value="">Sin precio</option><option value="CRC">CRC</option><option value="USD">USD</option></select></label>
                            <label>Unidad de venta<select @bind="current.SalesUnit"><option value="">Seleccioná</option>
                                @foreach (var unit in units)
                                {
                                    <option value="@unit.Symbol">@unit.Name (@unit.Symbol)</option>
                                }
                            </select></label>
                        </div>
                        <div class="revestik-product-photos">
                            <h3>Fotografías del producto</h3>
                            <p>Una imagen principal obligatoria y hasta cuatro adicionales. JPG, PNG o WebP; máximo 5 MB por imagen.</p>
                            @foreach (var image in current.Images.Where(x => !removedImages.Contains(x.Id)).OrderByDescending(x => x.Role == "ProductCover").ThenBy(x => x.DisplayOrder))
                            {
                                <div class="revestik-product-image-row" @key="image.Id">
                                    <img src="@($"/api/admin/public-catalog/images/{image.Id}/content")" alt="@image.AltEs" loading="lazy" />
                                    <span>@(image.Role == "ProductCover" ? "Imagen principal" : "Imagen adicional")</span>
                                    <button type="button" disabled="@busy" @onclick="() => RemoveStoredImage(image.Id)">Quitar</button>
                                </div>
                            }
                            @foreach (var staged in stagedImages)
                            {
                                <div class="revestik-product-image-row" @key="staged.Token">
                                    <img src="@($"/api/admin/public-catalog/images/staged/{staged.Token}")" alt="Imagen nueva pendiente" />
                                    <span>@(staged.Role == "ProductCover" ? "Imagen principal nueva" : "Imagen adicional nueva")</span>
                                    <button type="button" disabled="@busy" @onclick="() => RemoveStagedAsync(staged.Token)">Quitar</button>
                                </div>
                            }
                            <label>Elegir imagen principal<input type="file" accept="image/jpeg,image/png,image/webp" @ref="coverInput" @onchange="StageCoverAsync" disabled="@busy" /></label>
                            <label>Agregar imagen adicional<input type="file" accept="image/jpeg,image/png,image/webp" @ref="galleryInput" @onchange="StageGalleryAsync" disabled="@(busy || ImageCount >= 5)" /></label>
                        </div>
                        <details><summary>Traducciones opcionales</summary>
                            <label>Nombre en inglés<input maxlength="200" @bind="En.Name" /></label>
                            <label>Descripción en inglés<textarea rows="3" maxlength="4000" @bind="En.Description"></textarea></label>
                            <label>Nombre en alemán<input maxlength="200" @bind="De.Name" /></label>
                            <label>Descripción en alemán<textarea rows="3" maxlength="4000" @bind="De.Description"></textarea></label>
                        </details>
                        <details><summary>SEO (opcional)</summary>
                            <label>Título SEO español<input maxlength="180" @bind="Es.SeoTitle" /></label>
                            <label>Descripción SEO español<textarea maxlength="320" rows="2" @bind="Es.SeoDescription"></textarea></label>
                            @if (current.Id > 0) { <p>Dirección estable: /acabados/@current.Slug</p> }
                        </details>
                        <p class="revestik-editor-note">Las imágenes y los cambios se publican únicamente cuando confirmás.</p>
                    </div>
                    <div class="revestik-editor-actions">
                        <button type="button" disabled="@busy" @onclick="CancelAsync">Cancelar</button>
                        <button type="button" disabled="@busy" class="revestik-editor-primary" @onclick="ReviewSave">Revisar y guardar</button>
                    </div>
                }
            }
        </section>
    </div>
}

@if (heroEditing is { } currentHero)
{
    <div class="revestik-editor-backdrop">
        <section class="revestik-editor-dialog" role="dialog" aria-modal="true" aria-labelledby="finishes-hero-heading">
            <header class="revestik-editor-dialog-header">
                <div><p>REVESTIK · Acabados · Diapositiva @currentHero.Slot</p>
                    <h2 id="finishes-hero-heading">@(heroTarget == "heading" ? "Editar título" : heroTarget == "description" ? "Editar descripción" : "Cambiar fotografía")</h2></div>
                <button type="button" disabled="@busy" @onclick="CancelAsync" aria-label="Cerrar editor">×</button>
            </header>
            @if (!string.IsNullOrWhiteSpace(error)) { <p role="alert" class="revestik-editor-error">@error</p> }
            @if (heroConfirmSave)
            {
                <p>¿Guardar los cambios de esta diapositiva de Acabados?</p>
                <div class="revestik-editor-actions">
                    <button type="button" disabled="@busy" @onclick="() => heroConfirmSave = false">Volver</button>
                    <button type="button" class="revestik-editor-primary" disabled="@busy" @onclick="SaveHeroConfirmedAsync">Confirmar y guardar</button>
                </div>
            }
            else
            {
                <div class="revestik-editor-fields">
                    @if (heroTarget == "heading")
                    {
                        <label>Título en español *<input maxlength="180" @bind="currentHero.HeadingEs" /></label>
                        <details><summary>Traducciones opcionales</summary>
                            <label>Inglés<input maxlength="180" @bind="currentHero.HeadingEn" /></label>
                            <label>Alemán<input maxlength="180" @bind="currentHero.HeadingDe" /></label>
                        </details>
                    }
                    else if (heroTarget == "description")
                    {
                        <label>Descripción en español *<textarea rows="4" maxlength="1000" @bind="currentHero.DescriptionEs"></textarea></label>
                        <details><summary>Traducciones opcionales</summary>
                            <label>Inglés<textarea rows="3" maxlength="1000" @bind="currentHero.DescriptionEn"></textarea></label>
                            <label>Alemán<textarea rows="3" maxlength="1000" @bind="currentHero.DescriptionDe"></textarea></label>
                        </details>
                    }
                    else if (heroTarget == "image")
                    {
                        @if (heroPendingToken is not null)
                        {
                            <img class="revestik-editor-photo" src="@($"/api/admin/public-catalog/images/staged/{heroPendingToken}")" alt="Fotografía pendiente" />
                        }
                        else if (currentHero.HasImage && !heroRemoveImage)
                        {
                            <img class="revestik-editor-photo" src="@($"/media/finishes-hero/{currentHero.Slot}?v={Uri.EscapeDataString(currentHero.Version)}")" alt="Portada actual" />
                        }
                        else { <p>Esta diapositiva no tiene fotografía guardada.</p> }
                        <label>Seleccionar JPG, PNG o WebP (máximo 5 MB)
                            <input type="file" accept="image/jpeg,image/png,image/webp" @ref="heroFileInput" @onchange="StageHeroImageAsync" disabled="@busy" />
                        </label>
                        @if (currentHero.HasImage && heroPendingToken is null)
                        {
                            <label class="revestik-editor-checkbox"><input type="checkbox" @bind="heroRemoveImage" /> Quitar fotografía actual</label>
                        }
                    }
                </div>
                <div class="revestik-editor-actions">
                    <button type="button" disabled="@busy" @onclick="CancelAsync">Cancelar</button>
                    <button type="button" class="revestik-editor-primary" disabled="@busy" @onclick="ReviewHeroSave">Revisar y guardar</button>
                </div>
            }
        </section>
    </div>
}

@code {
    private IJSObjectReference? module;
    private DotNetObjectReference<PublicFinishesEditor>? callback;
    private HomeHeroSlideDto? heroEditing;
    private string heroTarget = "heading";
    private ElementReference heroFileInput;
    private string? heroPendingToken;
    private bool heroRemoveImage, heroConfirmSave;
    private ProductData? product;
    private ProductData? deletingProduct;
    private ProductData? publicationProduct;
    private bool confirmPublication;
    private string? publicationName;
    private List<CategoryDto> categories = [];
    private List<SubcategoryDto> subcategories = [];
    private List<Unit> units = [];
    private int selectedCategoryId;
    private ElementReference coverInput, galleryInput;
    private List<StagedImage> stagedImages = [];
    private HashSet<int> removedImages = [];
    private bool confirmSave, confirmDelete, busy;
    private string? error, deleteName;

    private Translation Es => product!.Translations.First(x => x.LanguageCode == "es");
    private Translation En => product!.Translations.First(x => x.LanguageCode == "en");
    private Translation De => product!.Translations.First(x => x.LanguageCode == "de");
    private int ImageCount => (product?.Images.Count(i => !removedImages.Contains(i.Id)) ?? 0) + stagedImages.Count;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            if (!await IsAdministratorAsync()) return;
            module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/public-finishes-editor.js?v=ACABADOS-RECOVERY-02");
            callback = DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("attach", callback);
        }
        catch (JSException)
        {
            error = "No se pudo iniciar el editor de Acabados. Recargá la página.";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<bool> IsAdministratorAsync()
    {
        var principal = (await AuthenticationState.GetAuthenticationStateAsync()).User;
        return principal.Identity?.IsAuthenticated == true && principal.IsInRole("Administrator");
    }

    private async Task LoadOptionsAsync()
    {
        if (module is null) return;
        categories = (await module.InvokeAsync<CategoryDto[]>("getCategories")).OrderBy(x => x.NameEs).ToList();
        subcategories = (await module.InvokeAsync<SubcategoryDto[]>("getSubcategories")).ToList();
        units = (await module.InvokeAsync<Unit[]>("getUnits")).Where(x => x.IsActive).ToList();
    }

    [JSInvokable]
    public async Task BeginHeroEditAsync(int slot, string field)
    {
        if (busy || product is not null || heroEditing is not null || confirmDelete || confirmPublication || module is null ||
            slot is < 1 or > 3 || field is not ("heading" or "description" or "image") ||
            !await IsAdministratorAsync()) return;
        busy = true;
        error = null;
        try
        {
            var slides = await module.InvokeAsync<HomeHeroSlideDto[]>("getHeroSlides");
            heroEditing = slides.FirstOrDefault(x => x.Slot == slot) ?? FinishesHeroDefaults.ForSlot(slot);
            heroTarget = field;
            heroPendingToken = null;
            heroRemoveImage = false;
            heroConfirmSave = false;
        }
        catch (JSException) { error = "No se pudo cargar la portada de Acabados."; }
        finally { busy = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task StageHeroImageAsync(ChangeEventArgs _)
    {
        if (busy || module is null || heroEditing is null || !await IsAdministratorAsync()) return;
        busy = true;
        error = null;
        try
        {
            var uploaded = await module.InvokeAsync<StagedImage>("stageImage", heroFileInput, "SiteHero");
            if (heroPendingToken is not null)
                await module.InvokeVoidAsync("discardImage", heroPendingToken);
            heroPendingToken = uploaded.Token;
            heroRemoveImage = false;
        }
        catch (JSException) { error = "No se pudo cargar la imagen de Acabados."; }
        finally { busy = false; await InvokeAsync(StateHasChanged); }
    }

    private void ReviewHeroSave()
    {
        if (busy || heroEditing is null) return;
        if (string.IsNullOrWhiteSpace(heroEditing.HeadingEs) || heroEditing.HeadingEs.Length > 180 ||
            string.IsNullOrWhiteSpace(heroEditing.DescriptionEs) || heroEditing.DescriptionEs.Length > 1000 ||
            (heroTarget == "image" && heroPendingToken is null && !heroRemoveImage))
        {
            error = "Completá el título y la descripción en español, o elegí una fotografía válida.";
            return;
        }
        error = null;
        heroConfirmSave = true;
    }

    private async Task SaveHeroConfirmedAsync()
    {
        if (busy || module is null || heroEditing is null || !await IsAdministratorAsync()) return;
        busy = true;
        error = null;
        try
        {
            await module.InvokeVoidAsync("saveHeroSlide", heroEditing.Slot, new
            {
                heroEditing.Version, heroEditing.HeadingEs, heroEditing.HeadingEn, heroEditing.HeadingDe,
                heroEditing.DescriptionEs, heroEditing.DescriptionEn, heroEditing.DescriptionDe,
                ImageToken = heroPendingToken, RemoveImage = heroRemoveImage
            });
            heroPendingToken = null;
            heroEditing = null;
            heroConfirmSave = false;
            await module.InvokeVoidAsync("refreshPage");
        }
        catch (JSException e)
        {
            heroConfirmSave = false;
            error = e.Message.Contains("409") ? "La portada cambió en otra sesión. Recargá antes de guardar." :
                "No se pudo guardar la portada. Revisá tu sesión y el archivo.";
        }
        finally { busy = false; await InvokeAsync(StateHasChanged); }
    }

    [JSInvokable]
    public async Task NewProductAsync()
    {
        if (busy || product is not null || heroEditing is not null || confirmDelete || confirmPublication || !await IsAdministratorAsync()) return;
        busy = true;
        error = null;
        try
        {
            await LoadOptionsAsync();
            product = new ProductData { Translations = [new() { LanguageCode = "es" }, new() { LanguageCode = "en" }, new() { LanguageCode = "de" }] };
            selectedCategoryId = 0;
            stagedImages = [];
            removedImages = [];
        }
        catch (JSException) { error = "No se pudo cargar el formulario. Revisá tu sesión."; }
        finally { busy = false; await InvokeAsync(StateHasChanged); }
    }

    [JSInvokable]
    public async Task EditProductAsync(int id)
    {
        if (id < 1 || busy || product is not null || heroEditing is not null || confirmDelete || confirmPublication || !await IsAdministratorAsync() || module is null) return;
        busy = true;
        error = null;
        try
        {
            await LoadOptionsAsync();
            product = await module.InvokeAsync<ProductData>("getProduct", id);
            EnsureTranslations();
            selectedCategoryId = subcategories.Where(x => product.SubcategoryIds.Contains(x.Id)).Select(x => x.CategoryId).Distinct().SingleOrDefault();
            stagedImages = [];
            removedImages = [];
        }
        catch (Exception e) when (e is JSException or InvalidOperationException) { product = null; error = "No se pudo cargar el producto; recargá y probá de nuevo."; }
        finally { busy = false; await InvokeAsync(StateHasChanged); }
    }

    private void EnsureTranslations()
    {
        if (product is null) return;
        foreach (var lang in new[] { "es", "en", "de" })
            if (!product.Translations.Any(t => t.LanguageCode == lang)) product.Translations.Add(new Translation { LanguageCode = lang });
    }

    private void ChangeCategory(ChangeEventArgs args)
    {
        selectedCategoryId = int.TryParse(args.Value?.ToString(), out var id) ? id : 0;
        product?.SubcategoryIds.RemoveAll(subId => !subcategories.Any(s => s.Id == subId && s.CategoryId == selectedCategoryId));
    }

    private void ToggleSubcategory(int id, bool checkedValue)
    {
        if (product is null) return;
        if (checkedValue && !product.SubcategoryIds.Contains(id)) product.SubcategoryIds.Add(id);
        if (!checkedValue) product.SubcategoryIds.Remove(id);
    }

    private void RemoveStoredImage(int id) => removedImages.Add(id);

    private Task StageCoverAsync(ChangeEventArgs _) => StageAsync(coverInput, "ProductCover");
    private Task StageGalleryAsync(ChangeEventArgs _) => StageAsync(galleryInput, "ProductGallery");

    private async Task StageAsync(ElementReference element, string role)
    {
        if (busy || module is null || product is null || !await IsAdministratorAsync()) return;
        busy = true;
        error = null;
        try
        {
            if (role == "ProductGallery" && ImageCount >= 5) { error = "El máximo es de cinco fotografías."; return; }
            var upload = await module.InvokeAsync<StagedImage>("stageImage", element);
            upload.Role = role;
            if (role == "ProductCover")
            {
                foreach (var old in stagedImages.Where(x => x.Role == "ProductCover").ToArray())
                {
                    await module.InvokeVoidAsync("discardImage", old.Token);
                    stagedImages.Remove(old);
                }
                foreach (var image in product.Images.Where(x => x.Role == "ProductCover")) removedImages.Add(image.Id);
            }
            stagedImages.Add(upload);
        }
        catch (JSException) { error = "No se pudo cargar la fotografía. Revisá el formato y tamaño máximo de 5 MB."; }
        finally { busy = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task RemoveStagedAsync(string token)
    {
        if (busy || module is null) return;
        busy = true;
        try
        {
            await module.InvokeVoidAsync("discardImage", token);
            stagedImages.RemoveAll(x => x.Token == token);
        }
        catch (JSException) { error = "No se pudo descartar la fotografía."; }
        finally { busy = false; }
    }

    private void ReviewSave()
    {
        if (busy || product is null) return;
        if (string.IsNullOrWhiteSpace(Es.Name) || string.IsNullOrWhiteSpace(Es.Description) ||
            selectedCategoryId < 1 || product.SubcategoryIds.Count is < 1 or > 30 ||
            product.SubcategoryIds.Any(id => !subcategories.Any(s => s.Id == id && s.CategoryId == selectedCategoryId)))
        {
            error = "Completá nombre y descripción en español y elegí al menos una subcategoría válida.";
            return;
        }
        if (ImageCount is < 1 or > 5 ||
            product.Images.Count(i => i.Role == "ProductCover" && !removedImages.Contains(i.Id)) + stagedImages.Count(i => i.Role == "ProductCover") != 1)
        {
            error = "Se requiere una imagen principal y un máximo de cinco fotografías.";
            return;
        }
        if (product.Price is < 0 || (product.Price.HasValue &&
            (product.Currency is not ("CRC" or "USD") || string.IsNullOrWhiteSpace(product.SalesUnit))))
        {
            error = "Si indicás precio, elegí una moneda y unidad de venta válidas.";
            return;
        }
        if (!product.Price.HasValue) product.Currency = null;
        error = null;
        confirmSave = true;
    }

    private async Task SaveConfirmedAsync()
    {
        if (busy || product is null || module is null || !await IsAdministratorAsync()) return;
        busy = true;
        error = null;
        try
        {
            var input = new
            {
                product.Slug, product.Brand, product.Price, product.Currency, product.SalesUnit, product.DisplayOrder,
                product.SubcategoryIds,
                Translations = product.Translations.Where(t => t.LanguageCode == "es" || !string.IsNullOrWhiteSpace(t.Name))
                    .Select(t => new { t.LanguageCode, t.Name, t.Description, t.SeoTitle, t.SeoDescription }).ToArray(),
                product.Version,
                PendingImages = stagedImages.Select((s, i) => new { s.Token, s.Role, DisplayOrder = i, AltEs = (string?)null, AltEn = (string?)null, AltDe = (string?)null }).ToArray()
            };
            if (product.Id == 0)
                await module.InvokeVoidAsync("createProduct", input);
            else
                await module.InvokeVoidAsync("saveProduct", product.Id, new
                {
                    Product = input,
                    PendingImages = input.PendingImages,
                    ExistingImages = product.Images.Select(i => new { i.Id, i.DisplayOrder, i.AltEs, i.AltEn, i.AltDe, i.Version }).ToArray(),
                    RemovedImageIds = removedImages.ToArray()
                });
            stagedImages.Clear();
            product = null;
            confirmSave = false;
            await module.InvokeVoidAsync("refreshPage");
        }
        catch (JSException e)
        {
            confirmSave = false;
            error = e.Message.Contains("409") ? "Otro usuario cambió el producto. Actualizá antes de guardar." :
                e.Message.Contains("401") || e.Message.Contains("403") ? "La sesión expiró o no tenés permisos." :
                "El servidor rechazó el guardado. Verificá el contenido, las imágenes y la clasificación.";
        }
        finally { busy = false; await InvokeAsync(StateHasChanged); }
    }

    [JSInvokable]
    public async Task AskDeleteProductAsync(int id)
    {
        if (busy || product is not null || heroEditing is not null || confirmDelete || confirmPublication || id <= 0 || module is null || !await IsAdministratorAsync()) return;
        busy = true;
        try
        {
            deletingProduct = await module.InvokeAsync<ProductData>("getProduct", id);
            deleteName = deletingProduct.Translations.FirstOrDefault(x => x.LanguageCode == "es")?.Name ?? deletingProduct.Slug;
            confirmDelete = true;
            error = null;
        }
        catch (JSException) { error = "No se pudo cargar el producto para eliminar."; }
        finally { busy = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task DeleteConfirmedAsync()
    {
        if (busy || deletingProduct is null || module is null || !await IsAdministratorAsync()) return;
        busy = true;
        error = null;
        try
        {
            await module.InvokeVoidAsync("deleteProduct", deletingProduct.Id, deletingProduct.Version);
            deletingProduct = null;
            publicationProduct = null;
            publicationName = null;
            confirmPublication = false;
            confirmDelete = false;
            await module.InvokeVoidAsync("refreshPage");
        }
        catch (JSException e)
        {
            error = e.Message.Contains("409") ? "El producto fue modificado en otra sesión. Recargá antes de borrar." :
                "No se pudo eliminar el producto. Revisá los permisos y posibles referencias.";
        }
        finally { busy = false; }
    }

    [JSInvokable]
    public async Task AskPublicationAsync(int id)
    {
        if (busy || product is not null || heroEditing is not null || confirmDelete || confirmPublication ||
            id <= 0 || module is null || !await IsAdministratorAsync()) return;
        busy = true;
        try
        {
            publicationProduct = await module.InvokeAsync<ProductData>("getProduct", id);
            publicationName = publicationProduct.Translations.FirstOrDefault(t => t.LanguageCode == "es")?.Name ?? publicationProduct.Slug;
            confirmPublication = true;
            error = null;
        }
        catch (JSException) { error = "No se pudo verificar el estado del producto."; }
        finally { busy = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task ChangePublicationConfirmedAsync()
    {
        if (busy || publicationProduct is null || module is null || !await IsAdministratorAsync()) return;
        busy = true;
        error = null;
        try
        {
            await module.InvokeVoidAsync("setPublication", publicationProduct.Id, publicationProduct.Version,
                !publicationProduct.IsPublished);
            publicationProduct = null;
            confirmPublication = false;
            await module.InvokeVoidAsync("refreshPage");
        }
        catch (JSException e)
        {
            error = e.Message.Contains("409") ? "El producto cambió; recargá antes de publicar o despublicar." :
                "No se pudo cambiar la publicación. Verificá imágenes y clasificación.";
        }
        finally { busy = false; await InvokeAsync(StateHasChanged); }
    }

    [JSInvokable]
    public async Task ToggleFeaturedAsync(string slug)
    {
        if (busy || module is null || !await IsAdministratorAsync() || string.IsNullOrWhiteSpace(slug)) return;
        busy = true;
        error = null;
        try
        {
            var items = await module.InvokeAsync<HomeSectionDto[]>("getSections");
            var section = items.FirstOrDefault(x => x.Key == "products")?.Clone() ?? new HomeSectionDto
            {
                Key = "products", Es = HomeSectionDefaults.Spanish("products")
            };
            if (section.FeaturedSlugs.Contains(slug)) section.FeaturedSlugs.Remove(slug);
            else if (section.FeaturedSlugs.Count >= 5)
            {
                error = "Solo podés destacar cinco productos. Quitá uno antes de agregar otro.";
                return;
            }
            else section.FeaturedSlugs.Add(slug);
            await module.InvokeVoidAsync("saveSection", "products", new HomeSectionWrite
            {
                Version = section.Version, Es = section.Es, En = section.En, De = section.De,
                FeaturedSlugs = section.FeaturedSlugs
            });
            await module.InvokeVoidAsync("refreshPage");
        }
        catch (JSException e)
        {
            error = e.Message.Contains("409") ? "Cambió la selección en otra sesión. Recargá antes de guardar." :
                "No se pudo actualizar la selección de destacados.";
        }
        finally { busy = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task CancelAsync()
    {
        if (busy) return;
        busy = true;
        try
        {
            if (module is not null && heroPendingToken is not null)
                try { await module.InvokeVoidAsync("discardImage", heroPendingToken); }
                catch (JSException) { }
            if (module is not null)
                foreach (var image in stagedImages)
                    try { await module.InvokeVoidAsync("discardImage", image.Token); }
                    catch (JSException) { /* Expired media removed by existing cleanup. */ }
        }
        finally
        {
            stagedImages = [];
            removedImages.Clear();
            heroEditing = null;
            heroPendingToken = null;
            heroRemoveImage = false;
            heroConfirmSave = false;
            product = null;
            deletingProduct = null;
            publicationProduct = null;
            publicationName = null;
            confirmPublication = false;
            confirmDelete = false;
            confirmSave = false;
            error = null;
            busy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        callback?.Dispose();
        if (module is null) return;
        try
        {
            foreach (var image in stagedImages)
                await module.InvokeVoidAsync("discardImage", image.Token);
            if (heroPendingToken is not null)
                await module.InvokeVoidAsync("discardImage", heroPendingToken);
            await module.InvokeVoidAsync("detach");
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

    public sealed class ProductData
    {
        public int Id { get; set; }
        public string Slug { get; set; } = "";
        public string Version { get; set; } = "";
        public bool IsPublished { get; set; }
        public string? Brand { get; set; }
        public decimal? Price { get; set; }
        public string? Currency { get; set; }
        public string? SalesUnit { get; set; }
        public int DisplayOrder { get; set; }
        public List<int> SubcategoryIds { get; set; } = [];
        public List<Translation> Translations { get; set; } = [];
        public List<StoredImage> Images { get; set; } = [];
    }
    public sealed class Translation
    {
        public string LanguageCode { get; set; } = "";
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public string? SeoTitle { get; set; }
        public string? SeoDescription { get; set; }
    }
    public sealed class StoredImage
    {
        public int Id { get; set; }
        public string Role { get; set; } = "";
        public string Version { get; set; } = "";
        public int DisplayOrder { get; set; }
        public string? AltEs { get; set; }
        public string? AltEn { get; set; }
        public string? AltDe { get; set; }
    }
    public sealed class StagedImage
    {
        public string Token { get; set; } = "";
        public string Name { get; set; } = "";
        public string Role { get; set; } = "";
    }
    public sealed class Unit
    {
        public string Name { get; set; } = "";
        public string Symbol { get; set; } = "";
        public bool IsActive { get; set; }
    }
}

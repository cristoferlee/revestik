@inherits LayoutComponentBase
@inject NavigationManager Navigation
@{
    var lang = Locale.FromUri(Navigation.Uri);
    var t = Locale.Get(lang);
    var activePage = SiteLinks.PageFromUri(Navigation.Uri);
    var publicSession = RequestContext?.User.Identity?.IsAuthenticated == true
        ? RequestContext.User.IsInRole("PublicCustomer") ? "customer" : "forbidden"
        : "guest";
}
<a class="skip-link" href="#main">@t.Skip</a>
<header class="site-header">
    <div class="header-shell">
        <a class="brand" href="@SiteLinks.Path(lang, 0)" aria-label="REVESTIK — @t.Nav[0]">
            <img class="corporate-logo corporate-logo-header" width="420" height="160" src="/assets/revestik-sidebar-logo.png" alt="REVESTIK" />
        </a>
        <button class="menu-toggle" type="button" aria-controls="primary-nav" aria-expanded="false" data-menu-toggle>
            <span>@t.Menu</span><span aria-hidden="true">☰</span>
        </button>
        <nav id="primary-nav" class="primary-nav" aria-label="@t.Navigation">
            @for (var i = 0; i < 5; i++)
            {
                var page = i;
                <a href="@SiteLinks.Path(lang, page)" aria-current="@(activePage == page ? "page" : null)">@t.Nav[page]</a>
            }
        </nav>
        <div class="header-tools">
            <PublicAccountControls />
            <a class="public-cart-link" href="@SiteLinks.CartPath(lang)" data-public-cart-link data-public-cart-session="@publicSession"
               aria-label="@(lang == "en" ? "Cart" : lang == "de" ? "Warenkorb" : "Carrito")"
               aria-current="@(SiteLinks.IsCartRoute(Navigation.Uri) ? "page" : null)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round" width="21" height="21" aria-hidden="true">
                    <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                    <path d="M1 1h4l2.6 13.1a2 2 0 0 0 2 1.6h9.8a2 2 0 0 0 2-1.6L23 6H6"/>
                </svg>
                <span class="public-cart-count" data-public-cart-count hidden></span>
            </a>
            <nav class="languages" aria-label="@t.Language">
                @foreach (var language in new[] { "es", "en", "de" })
                {
                    <a href="@SiteLinks.LanguagePath(language, Navigation.Uri)" lang="@language" aria-current="@(lang == language ? "true" : null)">@language.ToUpperInvariant()</a>
                }
            </nav>
            <WhatsAppContactLink Language="@lang" CssClass="header-cta" Label="@t.Nav[5]" />
        </div>
    </div>
</header>
@Body
<footer class="site-footer">
    <div class="footer-inner">
        <div class="footer-brand">
            <strong class="footer-wordmark">REVESTIK</strong>
        </div>
        <div class="footer-columns">
            <nav aria-label="@t.FooterExplore">
                <h2>@t.FooterExplore</h2>
                @for (var i = 1; i < 5; i++)
                {
                    var page = i;
                    <a href="@SiteLinks.Path(lang, page)">@t.Nav[page]</a>
                }
            </nav>
            <div class="footer-contact">
                <h2>@t.FooterContact</h2>
                <a href="@SiteLinks.Path(lang, 5)">@t.Nav[5]</a>
                <WhatsAppContactLink Language="@lang" CssClass="" Label="WhatsApp" HideWhenUnavailable="true" />
                <a href="tel:+50661682122">@L("Teléfono", "Phone", "Telefon"): +506 6168 2122</a>
                <span>@L("Ubicación: Parrita, Puntarenas, Costa Rica", "Location: Parrita, Puntarenas, Costa Rica", "Standort: Parrita, Puntarenas, Costa Rica")</span>
                <span>@L("Cobertura: según ubicación del proyecto", "Coverage: based on project location", "Einsatzgebiet: abhängig vom Projektstandort")</span>
                <span>@L("Horario: lunes a sábado, 8:00 a. m. – 5:00 p. m.", "Hours: Monday to Saturday, 8:00 AM – 5:00 PM", "Öffnungszeiten: Montag bis Samstag, 8:00–17:00 Uhr")</span>
                <span>@L("Domingo: cerrado", "Sunday: closed", "Sonntag: geschlossen")</span>
            </div>
            <div class="footer-legal">
                <h2>@t.FooterLegal</h2>
                <p>@t.LegalPending</p>
            </div>
        </div>
        <div class="footer-bottom"><small>© @DateTime.UtcNow.Year REVESTIK</small><small>Costa Rica</small></div>
    </div>
</footer>

@code {
    [CascadingParameter] private HttpContext? RequestContext { get; set; }

    private string L(string es, string en, string de) => Locale.FromUri(Navigation.Uri) switch
    {
        "en" => en,
        "de" => de,
        _ => es
    };
}

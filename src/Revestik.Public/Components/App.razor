@using Revestik.Public.Components.Editor
@using Revestik.Public.Hosting
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@{
    // Do not advertise canonical URLs for local/pre-release routes.
    // Only enable once a verified HTTPS public base URL is configured.
    var publicBase = SiteLinks.ValidatedPublicBaseUrl(Configuration["PublicSite:BaseUrl"]);
    var knownRoute = SiteLinks.IsKnownPublicRoute(Navigation.Uri);
    var currentPath = new Uri(Navigation.Uri).AbsolutePath;
    var language = Locale.FromUri(Navigation.Uri);
    var isEditingSite = PublicEditorAccess.CanEditPublicSite(RequestContext);
    if (RequestContext?.User.Identity?.IsAuthenticated == true &&
        RequestContext is not null && !RequestContext.Response.HasStarted)
    {
        RequestContext.Response.Headers.CacheControl = "private, no-store";
    }
}
<!DOCTYPE html>
<html lang="@Locale.FromUri(Navigation.Uri)">
<head>
    <base href="/" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href="/assets/revestik-rk.svg" />
    <link rel="stylesheet" href="/css/public.css" />
    <link rel="stylesheet" href="/css/public-auth.css?v=PUBLIC-AUTH-01C" />
    <link rel="stylesheet" href="/css/public-cart.css?v=PUBLIC-CART-01D" />
    <link rel="stylesheet" href="/css/public-projects.css?v=PROJECTS-01D-FIX01" />
    <link rel="stylesheet" href="/css/catalog.css?v=ACABADOS-RECOVERY-02" />
    @if (isEditingSite)
    {
        <link rel="stylesheet" href="/css/public-inline-editor.css?v=VERIFY02-PERSISTENCE-FIX" />
    }
    @if (isEditingSite && currentPath.TrimEnd('/') == SiteLinks.Path(language, 1))
    {
        <link rel="stylesheet" href="/css/public-project-tags-editor.css?v=PROJECTS-01D-A11Y01" />
    }
    @if (isEditingSite && currentPath.TrimEnd('/') == SiteLinks.Path(language, 1))
    {
        <link rel="stylesheet" href="/css/public-projects-editor.css?v=PROJECTS-01C-UI02" />
    }
    @if (publicBase is not null && knownRoute && !isEditingSite && RequestContext?.Response.StatusCode != StatusCodes.Status404NotFound)
    {
        <link rel="canonical" href="@(publicBase + currentPath)" />
        @foreach (var alternate in new[] { "es", "en", "de" })
        {
            <link rel="alternate" hreflang="@alternate" href="@(publicBase + SiteLinks.LanguagePath(alternate, Navigation.Uri))" />
        }
        <link rel="alternate" hreflang="x-default" href="@(publicBase + SiteLinks.LanguagePath("es", Navigation.Uri))" />
    }
    <HeadOutlet />
</head>
@* During editing, force full document navigation so each SSR page gets a fresh
       authorized editor island and its JS controls are attached once. Ordinary
       visitors retain the default enhanced-navigation behavior. *@
<body data-enhance-nav="@(isEditingSite ? "false" : null)">
    <Routes />
    <div id="public-cart-notice" class="public-cart-notice" role="status" aria-live="polite" hidden>
        <span data-public-cart-notice-text></span>
        <button type="button" data-public-cart-notice-close aria-label="Close notification">&times;</button>
    </div>
    @if (isEditingSite)
    {
        <PublicInlineEditor @rendermode="new InteractiveServerRenderMode(prerender: false)" />
        @if (currentPath.TrimEnd('/') == SiteLinks.Path(language, 2))
        {
            <PublicFinishesEditor @rendermode="new InteractiveServerRenderMode(prerender: false)" />
        }
        @if (currentPath.TrimEnd('/') == SiteLinks.Path(language, 1))
        {
            <PublicProjectsEditor @rendermode="new InteractiveServerRenderMode(prerender: false)" />
        }
    }
    @* Global SSR-safe image viewer. Javascript enhances explicitly opted-in photos only. *@
    <dialog id="public-image-viewer" class="public-image-viewer" aria-label="Image viewer">
        <div class="public-image-viewer-shell">
            <button class="public-image-viewer-close public-glass-control" type="button" data-viewer-close aria-label="Close image viewer" title="Close">&times;</button>
            <div class="public-image-viewer-stage" data-viewer-stage></div>
            <div class="public-image-viewer-toolbar">
                <button class="public-glass-control" type="button" data-viewer-prev aria-label="Previous photograph">&#8592;</button>
                <div class="public-image-viewer-caption" aria-live="polite">
                    <span data-viewer-title></span>
                    <span class="public-image-viewer-count" data-viewer-count></span>
                </div>
                <button class="public-glass-control" type="button" data-viewer-next aria-label="Next photograph">&#8594;</button>
            </div>
        </div>
    </dialog>
    <script src="/js/public-nav.js" defer></script>
    <script src="/js/public-auth.js?v=PUBLIC-AUTH-01C" defer></script>
    <script src="/js/public-cart.js?v=PUBLIC-CART-01D" defer></script>
    <script src="/js/public-hero.js" defer></script>
    <script src="/js/public-catalog-search.js?v=ACABADOS-RECOVERY-02" defer></script>
    <script src="/js/public-featured-products.js" defer></script>
    <script src="/js/public-image-viewer.js" defer></script>
    @* Legacy iframe preview will be removed only after the replacement is verified. *@
    <script src="/js/public-editor-preview.js" defer></script>
    @if (isEditingSite)
    {
        <script src="/_framework/blazor.web.js"></script>
    }
</body>
</html>

@code {
    [CascadingParameter] private HttpContext? RequestContext { get; set; }
}
